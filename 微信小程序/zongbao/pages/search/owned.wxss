/* pages/search/owned.wxss — P2 已购检索页 */
.os-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.os-input {
  flex: 1;
  background: #f6f7f9;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}
.os-btn {
  flex: none;
  width: 150rpx;
  color: #1e5eff;
  border-color: #1e5eff;
  font-size: 26rpx;
}
.os-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #9aa1ab;
  line-height: 1.7;
}
.os-empty {
  font-size: 26rpx;
  color: #6b7178;
  line-height: 1.8;
  padding: 16rpx 4rpx;
}
.os-total {
  font-size: 24rpx;
  color: #6b7178;
  margin-bottom: 8rpx;
}
.os-item {
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f6f7f9;
}
.os-item:last-of-type {
  border-bottom: none;
}
.os-title {
  font-size: 28rpx;
  font-weight: 600;
}
.os-chapter {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #1e5eff;
  background: #e8efff;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.os-snippet {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4e5561;
  line-height: 1.7;
}
.os-more {
  margin-top: 20rpx;
  width: 100%;
  color: #1e5eff;
  border-color: #1e5eff;
  font-size: 26rpx;
}
.os-done {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa1ab;
}
