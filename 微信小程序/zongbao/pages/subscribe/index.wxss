/* pages/subscribe/index.wxss — P2 订阅位 */
.sub-title {
  font-size: 30rpx;
  font-weight: 700;
}
.sub-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa1ab;
  line-height: 1.7;
}
.sub-group-title {
  margin: 22rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  font-size: 24rpx;
  color: #4e5561;
  background: #f6f7f9;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}
.chip.on {
  color: #1e5eff;
  background: #e8efff;
  font-weight: 600;
}
.sub-save {
  margin-top: 30rpx;
  width: 100%;
  background: #1e5eff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}
.saved-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #f6f7f9;
}
.saved-item:last-of-type {
  border-bottom: none;
}
.saved-name {
  font-size: 26rpx;
}
.saved-del {
  font-size: 24rpx;
  color: #d84431;
  padding: 4rpx 12rpx;
}
