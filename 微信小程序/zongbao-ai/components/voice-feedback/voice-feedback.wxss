.voice-feedback { padding: 30rpx; background: #f8f9fa; border-radius: 16rpx; margin: 20rpx 0; }
.vf-header { text-align: center; margin-bottom: 24rpx; }
.vf-title { font-size: 36rpx; font-weight: bold; color: #333; }
.vf-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; display: block; }

.vf-record-btn {
  width: 100%; height: 160rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  background: #007aff; color: #fff; font-size: 32rpx;
  margin-bottom: 20rpx; user-select: none;
}
.vf-record-btn.recording { background: #ff4d4f; animation: pulse 1s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.7; } }
.vf-record-text, .vf-recording-text { color: #fff; font-size: 32rpx; }

.vf-loading { text-align: center; padding: 20rpx; color: #999; font-size: 28rpx; }

.vf-transcript { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; }
.vf-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 8rpx; }
.vf-text { font-size: 28rpx; color: #333; line-height: 1.6; }

.vf-submit-btn {
  background: #007aff; color: #fff; font-size: 30rpx;
  border-radius: 12rpx; margin-top: 20rpx; padding: 16rpx 0;
}

.vf-result { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-top: 16rpx; }
.vf-score-circle {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: #e6f7ff; display: flex; flex-direction: column;
  align-items: center; justify-content: center; margin: 0 auto 20rpx;
}
.vf-score-num { font-size: 56rpx; font-weight: bold; color: #007aff; }
.vf-score-label { font-size: 24rpx; color: #999; }

.vf-refund-box { text-align: center; margin-bottom: 24rpx; }
.vf-refund-amount { font-size: 48rpx; font-weight: bold; color: #52c41a; }
.vf-refund-pct { font-size: 24rpx; color: #999; display: block; }

.vf-dimensions { border-top: 1rpx solid #eee; padding-top: 16rpx; }
.vf-dim-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.vf-dim-name { font-size: 26rpx; color: #666; }
.vf-dim-score { font-size: 26rpx; color: #333; font-weight: 500; }

.vf-suggestion, .vf-rationale { margin-top: 20rpx; padding: 16rpx; background: #f0f7ff; border-radius: 8rpx; }

.vf-email-box {
  background: #fff8e6; border-radius: 12rpx; padding: 24rpx;
  margin-top: 20rpx; border: 1rpx solid #ffd666;
}
.vf-email-title { font-size: 28rpx; color: #333; font-weight: 500; display: block; margin-bottom: 16rpx; }
.vf-email-input {
  border: 1rpx solid #d9d9d9; border-radius: 8rpx;
  padding: 16rpx 20rpx; font-size: 28rpx; margin-bottom: 16rpx;
}
.vf-email-btns { display: flex; gap: 16rpx; }
.vf-email-confirm {
  flex: 1; background: #faad14; color: #fff; font-size: 28rpx;
  border-radius: 8rpx; padding: 12rpx 0;
}
.vf-email-skip {
  flex: 1; background: #f5f5f5; color: #666; font-size: 28rpx;
  border-radius: 8rpx; padding: 12rpx 0;
}
.vf-email-note { font-size: 22rpx; color: #999; margin-top: 12rpx; display: block; text-align: center; }
/* v2 文字反馈主路径 */
.vf-textarea-box {
  background: #fafafa; border: 1rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 20rpx; margin-top: 16rpx;
}
.vf-textarea {
  width: 100%; min-height: 140rpx; font-size: 28rpx; color: #333;
  line-height: 1.6;
}
/* 一键标签 (便捷令) */
.vf-chips { margin-top: 16rpx; }
.vf-chips-label { font-size: 24rpx; color: #888; display: block; margin-bottom: 10rpx; }
.vf-chip-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.vf-chip {
  font-size: 26rpx; color: #555; background: #fff;
  border: 1rpx solid #d9d9d9; border-radius: 999rpx; padding: 8rpx 24rpx;
}
.vf-chip.on { color: #fff; background: #e34d42; border-color: #e34d42; }
