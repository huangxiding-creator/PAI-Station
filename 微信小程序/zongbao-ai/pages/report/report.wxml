<page-meta page-style="{{themeStyle}}" />
<view class="page {{d.unlocked || (d.sellable && paySupported) ? 'page-has-bar' : ''}}" wx:if="{{d}}">

  <!-- ══ 蓝图头部：报告题名区 ══ -->
  <view class="hero bp-grid ticks">
    <view style="height: {{nav.statusBarHeight}}px;"></view>
    <view class="rp-nav" style="height: {{nav.navHeight}}px">
      <view class="rp-back" bindtap="goBack">‹ 返回</view>
    </view>

    <view class="hero-inner">
      <view class="hero-kicker">{{d.cat_name}} · REPORT</view>
      <view class="rp-title">{{d.title}}</view>
      <view class="hero-sub">{{d.subtitle}}</view>

      <view class="hero-dwg mono">SKU {{d.sku}}<view class="dim-rule"></view><text class="dim-cap" wx:if="{{d.words_wan}}">{{d.words_wan}}万字</text></view>
    </view>
  </view>

  <!-- ══ v0.9.21 问报告 hero（用户令 1018 升维：小 pill → 大区常驻，置于简介之上；零购买门槛 REQ-006.AC0）══
       双通道=🎤按住说（WechatSI，冻结组件同款状态机）+ 大字输入区永在（插件缺失自动兜底）；
       气泡三段（REQ-007）：结论全文可复制/论据挂第N章角标/转化条→购买；每答带互动三钮；AI 标识常驻。 -->
  <view class="rp-ask-hero bp-grid ticks rise" id="askHero">
    <view class="rp-ask-hero-head">
      <view class="rp-ask-hero-mic {{askRecording ? 'rp-ask-hero-mic-on' : ''}}"><text>🎤</text></view>
      <view class="rp-ask-hero-tt">
        <view class="rp-ask-hero-title">免费问报告 · ASK FREE</view>
        <view class="rp-ask-hero-sub">每日 6 问免费，语音或文字皆可——每个答案，皆有出处</view>
      </view>
      <text class="rp-ask-hero-left mono" wx:if="{{askUnlimited}}">已解锁 · 无限问</text>
      <text class="rp-ask-hero-left mono" wx:elif="{{!askExhausted}}">今日剩 {{askLeft}} 问</text>
    </view>

    <!-- 大输入区 + 发送/语音双大钮并排（语音主路/文字永在；日 3 问用尽撤输入行） -->
    <block wx:if="{{!askExhausted}}">
      <textarea class="rp-ask-input" value="{{askInput}}" placeholder="问这份报告任何问题..."
                placeholder-class="rp-ask-hero-ph" maxlength="200" auto-height
                show-confirm-bar="{{false}}" cursor-spacing="16"
                bindinput="onAskInput" bindconfirm="onAskSend" />
      <view class="rp-ask-hero-btns">
        <view class="rp-ask-hero-voice {{askRecording ? 'rp-ask-hero-voice-on' : ''}}"
              bindtouchstart="onMicStart" bindtouchend="onMicEnd" bindtouchcancel="onMicEnd"
              hover-class="rp-ask-hero-btn-hover"><text>🎤 按住说</text></view>
        <view class="rp-ask-hero-send {{askBusy ? 'rp-ask-hero-send-busy' : ''}}"
              bindtap="onAskSend" hover-class="rp-ask-hero-btn-hover">{{askBusy ? '回答组织中…' : '发送提问'}}</view>
      </view>
      <view class="rp-ask-hero-tip" wx:if="{{askRecording}}">正在听你说 · 松开结束</view>
    </block>

    <!-- 气泡流：先问后答（结论全文/论据/转化条 + 每答互动三钮） -->
    <view class="rp-ask-flow" wx:if="{{asks.length}}">
      <block wx:for="{{asks}}" wx:key="idx" wx:for-item="a">
        <view class="rp-ask-q">{{a.q}}</view>
        <view class="rp-ask-a">
          <view class="rp-ask-loading" wx:if="{{a.loading}}">组织答案中…</view>
          <block wx:else>
            <text class="rp-ask-conc" user-select>{{a.conclusion}}</text>
            <view class="rp-ask-pt" wx:for="{{a.points}}" wx:key="ch" wx:for-item="p">
              <text class="rp-ask-chip mono">{{p.ch === 0 ? '试读' : '第' + p.ch + '章'}}</text>
              <text class="rp-ask-pt-t" user-select>{{p.text}}</text>
            </view>
            <view class="rp-ask-hint">
              <text class="rp-ask-hint-t" user-select>{{a.hint}}</text>
              <view class="rp-ask-buy" wx:if="{{!d.unlocked}}" bindtap="onAskBuyTap" hover-class="rp-ask-buy-hover">购买下载完整报告</view>
            </view>
            <!-- v0.9.21 每答互动三钮：点赞/转发计数上链报告本体（bump），海报复用报告转化海报链 -->
            <view class="rp-ask-acts">
              <view class="rp-ask-act {{a.liked ? 'rp-ask-act-on' : ''}}" data-idx="{{index}}" bindtap="onAskLike" hover-class="rp-ask-act-hover">
                <text>{{a.liked ? '✓ 已有用' : '👍 有用 +1'}}</text>
              </view>
              <button class="rp-ask-act" open-type="share" data-idx="{{index}}" bindtap="onAskShareTap" hover-class="rp-ask-act-hover">
                <text>📤 分享</text>
              </button>
              <view class="rp-ask-act" data-idx="{{index}}" bindtap="onAskPoster" hover-class="rp-ask-act-hover">
                <text>🖼️ 生成海报</text>
              </view>
            </view>
          </block>
        </view>
      </block>
    </view>

    <!-- 统一池用尽态（REQ-008：撤输入行不发下一问；已购者不出现购买引导） -->
    <view class="rp-ask-out" wx:if="{{askExhausted}}">
      <view class="rp-ask-out-t">{{askExhaustedMsg || '今日问数已用完，明日再来'}}</view>
      <button class="btn-primary rp-ask-out-btn" wx:if="{{!d.unlocked}}" hover-class="btn-hover" bindtap="onAskBuyTap">解锁报告 · 随时翻原文</button>
    </view>

    <!-- 参考声明常驻 -->
    <view class="rp-ask-ai">内容仅供参考 · 以报告原文为准</view>
  </view>

  <!-- 免费价值卡（1019 用户令：大力宣传免费，购买只在真需要时出现） -->
  <view class="card ticks rise">
    <view class="rp-price-row">
      <view class="rp-price {{d.unlocked ? 'rp-price-owned' : ''}}">{{d.unlocked ? '已解锁 · 永久阅读' : (d.sellable ? '免费读 · 免费问' : '整理中 · 暂未开放')}}</view>
      <view class="rp-badges">
        <text class="rs-badge" wx:for="{{d.badges}}" wx:key="k">{{item.k}}{{item.v ? ' ' + item.v : ''}}</text>
      </view>
    </view>

    <!-- 主行动条：未购=购买（iOS 隐藏），已购=打开 PDF -->
    <button
      wx:if="{{d.unlocked}}"
      class="btn-primary rp-act"
      hover-class="btn-hover"
      disabled="{{opening}}"
      bindtap="openPdf"
    >{{opening ? '打开中…' : '打开 PDF 全文'}}</button>
    <view
      wx:elif="{{d.sellable}}"
      class="btn-primary rp-act"
      hover-class="btn-hover"
      bindtap="goSample"
    >免费试读 · 展开样章</view>
    <view wx:elif="{{d.sellable}}" class="rp-ios-note muted">iOS 可免费试读与免费问，全文解锁请洽客服</view>
    <view wx:else class="rp-ios-note muted">本报告 PDF 整理中，开放购买前可先试读</view>

    <view class="muted rp-note">先试读、先提问，值不值得，您说了算——每一页，皆出自总包智库对公开资料的逐项核实</view>
  </view>

  <!-- 简介 -->
  <view class="card ticks rise" wx:if="{{d.intro_lede || d.intro}}">
    <view class="kicker kicker-on-paper rp-kicker">ABOUT · 报告简介</view>
    <view class="rp-lede" wx:if="{{d.intro_lede}}">{{d.intro_lede}}</view>
    <view class="rp-intro" wx:if="{{d.intro}}">{{d.intro}}</view>
  </view>

  <!-- 适用人群 -->
  <view class="card ticks rise" wx:if="{{d.audience}}">
    <view class="kicker kicker-on-paper rp-kicker">FOR · 适用人群</view>
    <view class="rp-intro">{{d.audience}}</view>
  </view>

  <!-- 章节目录（1012 一级目录：卷级头行 vol:true 色带呈现，章行缩进挂其下；单卷本回退平铺） -->
  <view class="card ticks rise" wx:if="{{d.chapters.length}}">
    <view class="kicker kicker-on-paper rp-kicker">CHAPTERS · 章节目录<text class="mono rp-ch-n">{{volCount ? volCount + '卷·' : ''}}{{chCount}}</text></view>
    <view class="rp-ch {{item.vol ? 'rp-ch-vol' : ''}}" wx:for="{{d.chapters}}" wx:key="id">
      <view class="rp-ch-t"><text class="mono rp-ch-id">{{item.id}}</text>{{item.title}}</view>
      <view class="muted rp-ch-d" wx:if="{{item.desc}}">{{item.desc}}</view>
    </view>
  </view>

  <!-- 试读（md2blocks 结构化渲染：标题/列表/表格/引用排版，裸 Markdown 符号不再出现） -->
  <view class="card ticks rise" wx:if="{{sampleBlocks.length}}" id="sampleCard">
    <view class="kicker kicker-on-paper rp-kicker">{{d.sample_label || '试读'}} · FREE</view>
    <view class="rp-sample {{sampleOpen ? '' : 'rp-sample-fold'}}">
      <block wx:for="{{sampleBlocks}}" wx:key="index" wx:for-item="b">

        <view wx:if="{{b.t === 'h1'}}" class="md-h1">
          <text user-select><template is="inl" data="{{segs: b.inl}}" /></text>
        </view>
        <view wx:elif="{{b.t === 'h2'}}" class="md-h2">
          <view class="h2-bar"></view>
          <text class="md-h2-text" user-select><template is="inl" data="{{segs: b.inl}}" /></text>
        </view>
        <view wx:elif="{{b.t === 'h3'}}" class="md-h3">
          <text user-select><template is="inl" data="{{segs: b.inl}}" /></text>
        </view>

        <view wx:elif="{{b.t === 'p'}}" class="md-p">
          <text user-select><template is="inl" data="{{segs: b.inl}}" /></text>
        </view>

        <view wx:elif="{{b.t === 'quote'}}" class="md-quote">
          <text user-select><template is="inl" data="{{segs: b.inl}}" /></text>
        </view>

        <view wx:elif="{{b.t === 'hr'}}" class="md-hr"></view>

        <view wx:elif="{{b.t === 'code'}}" class="md-code-wrap">
          <scroll-view scroll-x class="md-code-scroll" enhanced show-scrollbar="{{false}}">
            <text class="md-code" user-select>{{b.text}}</text>
          </scroll-view>
        </view>

        <view wx:elif="{{b.t === 'ul'}}" class="md-list">
          <view class="md-li" wx:for="{{b.items}}" wx:key="index" wx:for-item="li">
            <view class="li-dot"></view>
            <text class="li-text" user-select><template is="inl" data="{{segs: li}}" /></text>
          </view>
        </view>

        <view wx:elif="{{b.t === 'ol'}}" class="md-list">
          <view class="md-li" wx:for="{{b.items}}" wx:key="index" wx:for-item="li" wx:for-index="liIdx">
            <view class="li-num mono">{{b.nums[liIdx]}}</view>
            <text class="li-text" user-select><template is="inl" data="{{segs: li}}" /></text>
          </view>
        </view>

        <scroll-view wx:elif="{{b.t === 'table'}}" scroll-x class="md-tbl-scroll" enhanced show-scrollbar="{{false}}">
          <view class="md-tbl">
            <view class="md-tr md-tr-head">
              <view class="md-th" wx:for="{{b.head}}" wx:key="index" wx:for-item="cell">
                <text user-select><template is="inl" data="{{segs: cell}}" /></text>
              </view>
            </view>
            <view class="md-tr" wx:for="{{b.rows}}" wx:key="index" wx:for-item="row">
              <view class="md-td" wx:for="{{row}}" wx:key="index" wx:for-item="cell">
                <text user-select><template is="inl" data="{{segs: cell}}" /></text>
              </view>
            </view>
          </view>
        </scroll-view>

      </block>
    </view>
    <view class="rp-sample-more" bindtap="toggleSample">{{sampleOpen ? '收起试读 ▴' : '展开试读 ▾'}}</view>
    <!-- 试读尽头 CTA：读完即购（iOS 不渲染购买入口=虚拟支付铁律） -->
    <view class="rp-cta {{buying ? 'rp-cta-busy' : ''}}" wx:if="{{sampleOpen && d.sellable && !d.unlocked && paySupported}}" bindtap="buy" hover-class="rp-cta-hover">
      <text class="rp-cta-t">试读至此，全文由此展开</text>
      <text class="rp-cta-arrow">›</text>
    </view>
  </view>

  <!-- ══ 语音反馈+AI评分+按质退款（1017 用户令）：仅已解锁用户可见 ══ -->
  <voice-feedback wx:if="{{d.unlocked}}" sku="{{d.sku}}" reportTitle="{{d.title}}"
                  openid="{{openid || ''}}" />

  <!-- ══ v0.9.15 互动三件（用户令 1011）：有用 / 分享给同行 / 生成海报 ══
       合规（运营规范 3.2.1）：分享动作零诱导文案——赠次静默落账不提示；有用反馈可见 -->
  <view class="card ticks rise rp-social" wx:if="{{d}}">
    <view class="pill-row">
      <view class="pill {{usefulDone ? 'pill-on' : ''}}" bindtap="onUseful" hover-class="pill-hover">
        <view class="pill-glyph"><text>{{usefulDone ? '✓' : '👍'}}</text></view>
        <text class="pill-t">{{usefulDone ? '已点有用' : '有用 +1次'}}</text>
      </view>
      <button class="pill share-pill" open-type="share" bindtap="onShareTap" hover-class="pill-hover">
        <view class="pill-glyph"><text>📤</text></view>
        <text class="pill-t">分享给同行</text>
      </button>
      <view class="pill {{posterBusy ? 'pill-busy' : ''}}" bindtap="onPoster" hover-class="pill-hover">
        <view class="pill-glyph"><text>{{posterBusy ? '…' : '🖼️'}}</text></view>
        <text class="pill-t">{{posterBusy ? '生成中…' : '生成海报'}}</text>
      </view>
    </view>
    <view class="muted act-tip">点「有用」赠 1 次咨询机会 · 每份报告限一次</view>

    <!-- v0.9.21（用户令 1018 升维）：问报告小 pill 已升为页首 hero 大区（见简介上方）——本卡只留互动三件 -->
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- 吸底行动栏（1019 用户令改免费锚点）：未购=去免费问；已购=打开 PDF（购买只在问答用尽/深挖提示/试读尽头三处真需要时刻出现） -->
<view class="rp-bar" wx:if="{{d && (d.unlocked || (d.sellable && paySupported))}}">
  <view class="rp-bar-info" wx:if="{{!d.unlocked}}">
    <view class="rp-bar-price">免费问报告</view>
    <view class="rp-bar-sub muted">今日剩 {{askLeft}} 问 · 语音打字都行</view>
  </view>
  <view class="rp-bar-info" wx:if="{{d.unlocked}}">
    <view class="rp-bar-price">已解锁</view>
    <view class="rp-bar-sub muted">全量阅读 · 可下载保存</view>
  </view>
  <button
    wx:if="{{d.unlocked}}"
    class="btn-primary rp-bar-btn"
    hover-class="btn-hover"
    disabled="{{opening}}"
    bindtap="openPdf"
  >{{opening ? '打开中…' : '打开 PDF 全文'}}</button>
  <view
    wx:else
    class="btn-primary rp-bar-btn"
    hover-class="btn-hover"
    bindtap="goAsk"
  >🎤 去问报告</view>
</view>

<!-- 载入/错误态（显式取反，勿用 wx:else：编译器剥注释后会误配吸底栏 rp-bar 的 wx:if） -->
<view class="page" wx:if="{{!d}}">
  <view class="card ticks rp-state">
    <view wx:if="{{loading}}">
      <view class="muted">报告加载中…</view>
      <view class="rp-skel">
        <view class="rp-skel-l w60"></view><view class="rp-skel-l"></view><view class="rp-skel-l w40"></view>
      </view>
    </view>
    <view wx:else>
      <view class="rp-state-t">{{errMsg || '报告不存在'}}</view>
      <view class="rp-state-btns">
        <button class="btn-primary rp-act" hover-class="btn-hover" bindtap="retry">重试</button>
        <button class="btn-primary rp-act" hover-class="btn-hover" bindtap="goBack">返回目录</button>
      </view>
    </view>
  </view>
</view>

<!-- v0.9.7 自绘弹窗系统：qw-pop 自绘弹窗（onPopState 镜像开合+tabBar 让路）（onPopState 镜像开合+tabBar 让路） -->
<qw-pop id="qwpop" bind:popstate="onPopState" />

<!-- ══ v0.9.16 授勋动画（1012 用户令：有用赠次与答案页统一动画）——徽章+光芒+火花荣誉时刻 ══ -->
<view class="rw-mask" wx:if="{{rewardShow}}" catchtouchmove="noop">
  <view class="rw-flash"></view>
  <view class="rw-core">
    <view class="rw-rays"></view>
    <view class="rw-medal"><text class="rw-plus">+1</text></view>
  </view>
  <view class="rw-title">咨询机会 +1</view>
  <view class="rw-sub">{{reward}}</view>
  <view class="rw-sp sp0"></view><view class="rw-sp sp1"></view><view class="rw-sp sp2"></view><view class="rw-sp sp3"></view>
  <view class="rw-sp sp4"></view><view class="rw-sp sp5"></view><view class="rw-sp sp6"></view><view class="rw-sp sp7"></view>
</view>

<!-- 行内段渲染模板：加粗/斜体/行内代码/链接（与 answer 页同款） -->
<template name="inl">
  <block wx:for="{{segs}}" wx:key="index" wx:for-item="s">
    <text wx:if="{{s.k === 'b'}}" class="in-b" user-select>{{s.v}}</text>
    <text wx:elif="{{s.k === 'i'}}" class="in-i" user-select>{{s.v}}</text>
    <text wx:elif="{{s.k === 'c'}}" class="in-c" user-select>{{s.v}}</text>
    <text wx:elif="{{s.k === 'l'}}" class="in-l" user-select>{{s.v}}</text>
    <block wx:else><text user-select>{{s.v}}</text></block>
  </block>
</template>
