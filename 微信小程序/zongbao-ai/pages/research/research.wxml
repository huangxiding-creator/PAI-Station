<page-meta page-style="{{themeStyle}}" />
<view class="page">

  <!-- ══ 蓝图头部：研究 · 报告商城 ══ -->
  <view class="hero bp-grid ticks">
    <view style="height: {{nav.statusBarHeight}}px;"></view>
    <view class="hero-nav" style="height: {{nav.navHeight}}px"></view>

    <view class="hero-inner">
      <view class="hero-kicker">ASK THE REPORT · RESEARCH</view>
      <view class="hero-title">问报告</view>
      <view class="hero-sub">提问，即是最深的阅读。{{statsReady ? stats.sellable : '—'}} 份深度研究，每日 6 问免费，句句有出处</view>
      <view class="rs-ask-cta" bindtap="onAskReport" hover-class="rs-ask-cta-hover">立即问报告 · 前 6 问免费</view>
      <view class="hero-note">商城在下——每份开放试读，一次解锁，永久阅读与下载 · 满 ¥200 可开增值税专用发票</view>

      <!-- 变现数据带：在售/起价/已解锁（口径=目录 API 实数 + 实价 ¥498 起，可证成） -->
      <view class="rs-hero-stats">
        <view class="rs-hs"><text class="rs-hs-n mono">{{statsReady ? stats.sellable : '—'}}</text><text class="rs-hs-l">份在售</text></view>
        <view class="rs-hs-div"></view>
        <view class="rs-hs"><text class="rs-hs-n mono">¥{{statsReady && stats.pmin ? stats.pmin : '—'}}</text><text class="rs-hs-l">起</text></view>
        <view class="rs-hs-div"></view>
        <view class="rs-hs"><text class="rs-hs-n mono">{{statsReady ? stats.mine : '—'}}</text><text class="rs-hs-l">已解锁</text></view>
      </view>

      <view class="hero-dwg mono">DWG NO. RS-01 · SCALE 1:1<view class="dim-rule"></view><text class="dim-cap">{{statsReady ? stats.sellable : '—'}} ON SALE</text></view>
    </view>
  </view>

  <!-- ══ v0.9.21 第一区：最新研报（引擎目录序 TOP 3，不受筛选影响）══ -->
  <view class="card ticks rise" wx:if="{{latest.length}}">
    <view class="rs-sec">
      <view class="rs-sec-bar"></view>
      <text class="rs-sec-title">最新研报 · LATEST</text>
      <text class="rs-sec-cap mono">TOP 3</text>
    </view>
    <view class="rs-list">
      <view class="rs-item {{item.unlocked ? 'rs-item-owned' : ''}}" wx:for="{{latest}}" wx:key="sku" data-sku="{{item.sku}}" bindtap="goReport" hover-class="rs-item-hover">
        <view class="rs-item-top">
          <view class="rs-item-top-l">
            <text class="rs-top3 mono">TOP {{index + 1}}</text>
            <view class="rs-cat mono">{{item.cat_name}}</view>
          </view>
          <view class="rs-state {{item.unlocked ? 'rs-state-on' : (item.sellable ? '' : 'rs-state-dim')}}">{{item.unlocked ? '已解锁' : (item.sellable ? item.price_label : '整理中')}}</view>
        </view>
        <view class="rs-title">{{item.title}}</view>
        <view class="rs-sub muted">{{item.subtitle}}</view>
        <view class="rs-item-bot">
          <view class="rs-badges">
            <text class="rs-badge" wx:if="{{bi < 3}}" wx:for="{{item.badges}}" wx:for-item="b" wx:for-index="bi" wx:key="k">{{b.k}}{{b.v ? ' ' + b.v : ''}}</text>
          </view>
          <view class="rs-words mono" wx:if="{{item.words_wan}}">{{item.words_wan}}万字</view>
        </view>
        <view class="rs-acts mono">观看 {{item.views || 0}} · 点赞 {{item.likes || 0}} · 转发 {{item.shares || 0}}</view>
      </view>
    </view>
  </view>

  <!-- 分类筛选（v0.9.21：只作用于最热区） -->
  <view class="rs-filters card ticks">
    <view
      class="rs-chip {{active === item.k ? 'rs-chip-on' : ''}}"
      wx:for="{{filters}}"
      wx:key="k"
      data-k="{{item.k}}"
      bindtap="tapFilter"
    >{{item.label}}<text wx:if="{{item.k === 'mine' && stats.mine}}" class="rs-chip-n mono">{{stats.mine}}</text></view>
  </view>

  <!-- ══ v0.9.21 第二区：最热研报（互动热度倒序=观看+点赞+转发；分类筛子作用域）══ -->
  <view class="card ticks rise" wx:if="{{shown.length}}">
    <view class="rs-sec">
      <view class="rs-sec-bar rs-sec-bar-hot"></view>
      <text class="rs-sec-title">最热研报 · HOT</text>
      <text class="rs-sec-cap mono">观看+点赞+转发</text>
    </view>
    <view class="rs-list">
      <view class="rs-item {{item.unlocked ? 'rs-item-owned' : ''}}" wx:for="{{shown}}" wx:key="sku" data-sku="{{item.sku}}" bindtap="goReport" hover-class="rs-item-hover">
        <view class="rs-item-top">
          <view class="rs-cat mono">{{item.cat_name}}</view>
          <view class="rs-state {{item.unlocked ? 'rs-state-on' : (item.sellable ? '' : 'rs-state-dim')}}">{{item.unlocked ? '已解锁' : (item.sellable ? item.price_label : '整理中')}}</view>
        </view>
        <view class="rs-title">{{item.title}}</view>
        <view class="rs-sub muted">{{item.subtitle}}</view>
        <view class="rs-item-bot">
          <view class="rs-badges">
            <text class="rs-badge" wx:if="{{bi < 3}}" wx:for="{{item.badges}}" wx:for-item="b" wx:for-index="bi" wx:key="k">{{b.k}}{{b.v ? ' ' + b.v : ''}}</text>
          </view>
          <view class="rs-item-right">
            <text class="rs-heat mono" wx:if="{{item.heat > 0}}">🔥{{item.heat}}</text>
            <view class="rs-words mono" wx:if="{{item.words_wan}}">{{item.words_wan}}万字</view>
          </view>
        </view>
        <view class="rs-acts mono">观看 {{item.views || 0}} · 点赞 {{item.likes || 0}} · 转发 {{item.shares || 0}}</view>
      </view>
    </view>
  </view>

  <!-- 空/载入/错误态 -->
  <view class="card ticks" wx:if="{{!loading && !shown.length && !errMsg}}">
    <view class="rs-empty">
      <view class="rs-empty-t">{{active === 'mine' ? '还没有解锁的报告' : '这个筛选下暂无热门报告'}}</view>
      <view class="muted">{{active === 'mine' ? '购买后这里就是你的书架' : '换个分类看看，或浏览上方最新研报'}}</view>
    </view>
  </view>
  <view class="card ticks" wx:if="{{errMsg}}">
    <view class="rs-empty">
      <view class="rs-empty-t">{{errMsg}}</view>
      <button class="btn-primary rs-retry" hover-class="btn-hover" bindtap="retry">重新加载</button>
    </view>
  </view>
  <!-- 载入骨架：与目录卡片同构的微光占位（v0.9.1 逐页优化） -->
  <view class="card ticks" wx:if="{{loading && !shown.length}}">
    <view class="rs-skel-item" wx:for="{{[0, 1, 2]}}" wx:key="*this">
      <view class="rs-skel-l w30"></view>
      <view class="rs-skel-l w90"></view>
      <view class="rs-skel-l w60"></view>
      <view class="rs-skel-chips">
        <view class="rs-skel-chip"></view>
        <view class="rs-skel-chip w2"></view>
        <view class="rs-skel-chip w3"></view>
      </view>
    </view>
  </view>

  <!-- 合规注脚 -->
  <view class="rs-foot muted">每一份报告，都是研究团队从公开资料里逐项核实出来的。买后随时读、随时下载；有任何问题，客服都在</view>

  <view class="safe-bottom"></view>
</view>
