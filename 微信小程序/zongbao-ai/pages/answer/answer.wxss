/* 答案页 — v0.3.0 蓝图设计：蓝图带（导航+问题）→ 白图纸面（解答） */
.page { padding-bottom: 40rpx; }

/* ══ 自绘导航 ══ */
.topnav { position: relative; z-index: 5; }
.topnav-row {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}
.back-btn {
  width: 60rpx; height: 60rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(var(--t-inkdim-rgb), 0.5);
  color: var(--white-ink);
  font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  line-height: 1;
  margin-top: -4rpx;
}
.back-hover { background: rgba(var(--t-glow-rgb), 0.15); }
.topnav-title {
  margin-left: 20rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: var(--ink-dim);
  font-weight: 600;
}

/* 顶栏右侧铭牌（语音撤除后） */
.topnav-cap {
  margin-left: auto;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(var(--t-inkdim-rgb), 0.5);
  color: var(--ink-dim);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  display: flex; align-items: center;
  line-height: 1;
}

/* ══ 问题芯片：蓝图底白墨 ══ */
.q-band {
  margin: -2rpx 24rpx 22rpx;
  border: 2rpx solid rgba(var(--t-glow-rgb), 0.3);
  border-radius: 8rpx;
  color: var(--white-ink);
  position: relative;
}
.q-band-inner { padding: 26rpx 28rpx 30rpx; border-left: 6rpx solid var(--accent); }
.q-kicker {
  font-size: 19rpx; letter-spacing: 6rpx;
  color: var(--ink-dim);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 34rpx; font-weight: 700; line-height: 1.55;
  color: var(--white-ink);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.22);
}

/* ══ 绘制中：绘图仪扫描动画 ══ */
.draft-card { padding: 26rpx 28rpx 28rpx; }
.draft-stage {
  position: relative;
  height: 120rpx;
  border: 2rpx dashed rgba(var(--t-navy2-rgb), 0.22);
  border-radius: 8rpx;
  overflow: hidden;
  background-color: var(--t-paper-hi);
  background-image:
    linear-gradient(rgba(var(--t-blue-rgb), 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--t-blue-rgb), 0.07) 1px, transparent 1px);
  background-size: 28rpx 28rpx;
}
/* 扫描线：往返移动的绘图笔 */
.plotter-line {
  position: absolute; top: 12rpx; bottom: 12rpx; left: 0;
  width: 3rpx;
  background: linear-gradient(180deg, transparent, var(--accent) 22%, var(--accent) 78%, transparent);
  box-shadow: 0 0 18rpx rgba(var(--t-accent-rgb), 0.65);
  animation: plot 2.2s ease-in-out infinite alternate;
}
@keyframes plot {
  from { left: 6%; }
  to { left: 94%; }
}
.draft-elapsed {
  position: absolute; right: 14rpx; bottom: 8rpx;
  font-size: 22rpx; color: var(--navy-1);
  opacity: 0.75;
}
.draft-head { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; }
.draft-dot {
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: var(--accent);
  animation: pulse 1.1s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.5; } }
.draft-title { font-weight: 800; font-size: 30rpx; letter-spacing: 2rpx; }

.proc-list { margin-top: 22rpx; padding-left: 8rpx; border-left: 2rpx solid var(--t-paper-dim); }
.proc-item {
  display: flex; gap: 18rpx;
  padding: 10rpx 0 10rpx 22rpx; font-size: 26rpx; color: var(--ink-2);
  position: relative;
  animation: fadeIn 0.3s ease both;
}
.proc-item::before {
  content: '';
  position: absolute; left: -7rpx; top: 22rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--t-glow-soft);
}
.proc-t { color: var(--muted); min-width: 64rpx; text-align: right; font-size: 24rpx; }
.proc-current .proc-x { color: var(--draft); font-weight: 600; }
.proc-tip { margin-top: 24rpx; text-align: center; }

/* ══ 解答头 ══ */
.a-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx; flex-wrap: wrap;
  padding-bottom: 22rpx; border-bottom: 2rpx solid var(--line);
}
.a-badge {
  display: inline-flex; align-items: center; gap: 10rpx;
  font-size: 26rpx; font-weight: 700; color: var(--navy-1);
  letter-spacing: 1rpx;
}
.a-badge-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 6rpx rgba(var(--t-accent-rgb), 0.16);
}
.a-meta { display: flex; gap: 12rpx; }
.meta-chip {
  font-size: 21rpx; color: var(--navy-1);
  background: var(--t-paper-cool); border: 2rpx solid var(--t-blue-tint);
  border-radius: 4rpx; padding: 4rpx 16rpx;
  letter-spacing: 1rpx;
}

/* ══ Markdown 排版系统（白图纸面） ══ */
.md { margin-top: 6rpx; }
.md-p {
  font-size: 30rpx; line-height: 1.92; color: var(--ink-2);
  letter-spacing: 0.3rpx; text-align: justify;
  margin: 0 0 26rpx;
}
.md-h1 {
  font-size: 36rpx; font-weight: 800; color: var(--navy-0); line-height: 1.45;
  margin: 40rpx 0 22rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid var(--accent);
}
.md-h2 { display: flex; align-items: center; gap: 16rpx; margin: 44rpx 0 20rpx; }
.h2-bar {
  width: 12rpx; height: 34rpx; border-radius: 3rpx; flex-shrink: 0;
  background: linear-gradient(180deg, var(--navy-2), var(--navy-0));
  box-shadow: 4rpx 0 0 rgba(var(--t-accent-rgb), 0.75);
}
.md-h2-text { font-size: 33rpx; font-weight: 800; color: var(--navy-0); line-height: 1.5; }
.md-h3 {
  font-size: 31rpx; font-weight: 700; color: var(--navy-1);
  margin: 34rpx 0 16rpx;
}
.md-quote {
  border-left: 6rpx solid var(--draft);
  background: var(--t-paper-cool);
  border-radius: 0 8rpx 8rpx 0;
  padding: 20rpx 24rpx; margin: 0 0 26rpx;
  font-size: 28rpx; color: var(--ink-2); line-height: 1.85;
}
.md-hr {
  height: 2rpx; margin: 38rpx 0;
  background: repeating-linear-gradient(90deg, var(--line) 0 26rpx, transparent 26rpx 42rpx);
}
.md-code-wrap {
  background: var(--navy-1); border-radius: 10rpx; margin: 0 0 26rpx;
  padding: 26rpx 24rpx; overflow: hidden;
  border: 2rpx solid rgba(var(--t-glow-rgb), 0.25);
}
.md-code-scroll { width: 100%; }
.md-code {
  font-family: "SF Mono", Menlo, Consolas, "Courier New", monospace;
  font-size: 25rpx; line-height: 1.75; color: var(--t-glow-soft); white-space: pre;
}
.md-list { margin: 0 0 26rpx; }
.md-li { display: flex; gap: 16rpx; align-items: flex-start; }
.md-li + .md-li { margin-top: 14rpx; }
.li-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--accent); flex-shrink: 0; margin-top: 21rpx;
  box-shadow: 0 0 0 5rpx rgba(var(--t-accent-rgb), 0.14);
}
.li-num {
  min-width: 38rpx; height: 38rpx; border-radius: 4rpx;
  background: var(--navy-0); color: var(--white-ink);
  font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 9rpx;
}
.li-text { flex: 1; font-size: 30rpx; line-height: 1.85; color: var(--ink-2); }

/* 行内段 */
.in-b { font-weight: 700; color: var(--navy-0); }
.in-i { font-style: italic; color: var(--ink-2); }
.in-c {
  font-family: "SF Mono", Menlo, Consolas, "Courier New", monospace;
  font-size: 26rpx; background: var(--t-paper-edge); color: var(--t-amber-ink);
  padding: 2rpx 12rpx; border-radius: 6rpx;
}
.in-l { color: var(--draft); text-decoration: underline; }

/* 表格：图签风格（深蓝表头白墨） */
.md-tbl-scroll { width: 100%; margin-bottom: 26rpx; }
.md-tbl { display: inline-block; min-width: 100%; border-radius: 6rpx; overflow: hidden; border: 2rpx solid var(--t-paper-edge); }
.md-tr { display: flex; }
.md-tr-head { background: var(--navy-0); }
.md-th, .md-td {
  padding: 16rpx 22rpx; font-size: 26rpx; line-height: 1.6;
  flex-shrink: 0; max-width: 420rpx;
}
.md-th { font-weight: 700; color: var(--white-ink); letter-spacing: 1rpx; }
.md-td { color: var(--ink-2); border-top: 2rpx solid var(--line); background: var(--t-paper-hi); }
.md-tr .md-th + .md-th { border-left: 2rpx solid rgba(var(--t-glow-rgb), 0.3); }
.md-tr .md-td + .md-td { border-left: 2rpx solid var(--line); }

/* 首块不吃上边距 */
.md > view:first-child, .md > scroll-view:first-child { margin-top: 0; }

/* ══ v0.7.0 流式打字机：生成中先睹为快 ══ */
.draft-chars {
  margin-left: auto;
  font-size: 22rpx; color: var(--accent-deep);
  letter-spacing: 1rpx;
  background: var(--t-amber-bg);
  border: 2rpx solid var(--t-amber-line);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}
.type-box {
  margin-top: 22rpx;
  border: 2rpx solid var(--t-paper-dim);
  border-left: 6rpx solid var(--accent);
  border-radius: 10rpx;
  background: var(--t-paper-hi);
  padding: 24rpx 26rpx 20rpx;
  max-height: 760rpx;
  overflow: hidden;
  position: relative;
}
.md-dim .md-p, .md-dim .li-text { font-size: 28rpx; }
.type-caret {
  display: flex; justify-content: flex-start;
  padding-top: 4rpx;
}
.caret-bar {
  width: 30rpx; height: 36rpx;
  background: var(--accent);
  animation: caretBlink 0.9s steps(1) infinite;
  border-radius: 2rpx;
}
@keyframes caretBlink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }

/* ══ 依据来源：图签栏 ══ */
.cite-block { margin-top: 32rpx; border-top: 2rpx solid var(--line); padding-top: 26rpx; }
.cite-tbl {
  border: 2rpx solid var(--t-paper-edge);
  border-radius: 6rpx;
  overflow: hidden;
  background: var(--t-paper-hi);
}
.cite-item { display: flex; gap: 16rpx; align-items: flex-start; padding: 16rpx 20rpx; }
.cite-item + .cite-item { border-top: 2rpx dashed var(--line); }
.cite-chip {
  flex-shrink: 0;
  min-width: 38rpx; height: 38rpx; border-radius: 4rpx;
  background: var(--navy-0); color: var(--white-ink);
  font-size: 21rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  padding: 0 8rpx; margin-top: 2rpx;
}
.cite-body { flex: 1; font-size: 25rpx; color: var(--ink-2); line-height: 1.7; }
.cite-loc { color: var(--muted); margin-left: 10rpx; }
.cite-hover { background: var(--t-paper-hi); }
.cite-arrow {
  flex-shrink: 0; align-self: center;
  color: var(--draft); font-size: 34rpx; font-weight: 700;
  padding-left: 6rpx;
}

/* ══ v0.7.0 共享入锅圈带（用户令 0930 第 8 条）══ */
.share-band {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 26rpx;
  border-left: 6rpx solid var(--accent);
}
.sb-glyph {
  flex-shrink: 0;
  width: 76rpx; height: 76rpx;
  border-radius: 14rpx;
  background: var(--navy-0);
  color: var(--white-ink);
  font-size: 34rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(var(--t-navy1-rgb), 0.22);
}
.sb-glyph-on { background: var(--accent); color: var(--navy-0); }
.sb-main { flex: 1; min-width: 0; }
.sb-title { font-size: 28rpx; font-weight: 800; color: var(--ink); letter-spacing: 1rpx; }
.sb-sub { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; }
.sb-btn {
  flex-shrink: 0;
  padding: 0 34rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, var(--t-accent-soft) 0%, var(--accent) 45%, var(--accent-deep) 100%);
  color: var(--navy-0);
  font-size: 26rpx; font-weight: 800; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(var(--t-accent-rgb), 0.32);
}
.sb-btn-hover { transform: scale(0.96); }
.sb-btn-off {
  background: transparent;
  color: var(--muted);
  border: 2rpx solid var(--t-paper-edge);
  box-shadow: none;
}
.sb-busy { opacity: 0.55; }

/* ══ 互动小按钮排（用户令 v0.5.0：精美小按钮）══ */
.act-card { padding: 26rpx 22rpx 20rpx; }
.pill-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx 14rpx;
}
.pill {
  display: flex; flex-direction: column; align-items: center;
  gap: 6rpx;
  min-width: 118rpx;
  padding: 16rpx 12rpx 12rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--t-paper-dim);
  background: var(--t-paper-hi);
  line-height: 1.35;
}
.pill-hover {
  background: var(--navy-0);
  border-color: var(--navy-0);
  transform: scale(0.96);
}
/* v0.9.5 审计修（U2）：在途置灰——慢网点赞等回包期间不再是"点了没反应" */
.pill-busy { opacity: 0.55; }
.pill-glyph {
  width: 52rpx; height: 52rpx;
  border-radius: 50%;
  background: var(--t-paper-cool);
  border: 2rpx solid var(--t-blue-tint);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx;
  line-height: 1;
}
.pill-t {
  font-size: 21rpx; color: var(--ink-2);
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.pill-on {
  border-color: var(--t-amber-line);
  background: var(--t-amber-bg);
}
.pill-on .pill-glyph {
  background: var(--t-amber-bg);
  border-color: var(--t-amber-line);
}
.pill-on .pill-t { color: var(--accent-deep); font-weight: 700; }
.pill-hover .pill-t { color: var(--white-ink); }
/* 分享 pill 是 button：抹平原生样式 */
.share-pill {
  margin: 0;
  font-size: inherit;
  font-weight: 400;
}
.share-pill::after { border: none; }
button.share-pill .pill-t { color: var(--ink-2); }
.act-tip { text-align: center; margin-top: 20rpx; letter-spacing: 1rpx; font-size: 21rpx; }

/* ══ 骨架屏（纸面色调） ══ */
.sk { background: linear-gradient(90deg, var(--t-paper-dim) 25%, var(--t-paper-hi) 45%, var(--t-paper-dim) 65%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; border-radius: 6rpx; }
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
.sk-title { height: 40rpx; width: 70%; }
.sk-line { height: 30rpx; margin-top: 24rpx; }
.sk-line.short { width: 55%; }
.loading-hint { margin-top: 28rpx; color: var(--muted); font-size: 24rpx; text-align: center; }

/* ══ 失败卡 ══ */
.err-card { text-align: center; padding: 60rpx 32rpx; }
.err-kicker { display: block; margin-bottom: 14rpx; }
.refund-note { margin-top: 8rpx; color: var(--accent-deep); }
.retry-btn { margin-top: 30rpx; width: 60%; }

/* ══ v0.6.0 等待打勾：已完成阶段 ✓（调研：分段进度打勾=10s+ 档标准解）══ */
.proc-check { color: var(--accent-deep); font-weight: 700; font-size: 24rpx; }

/* ══ v0.6.0 要点速览卡：3 条 15 秒读完 ══ */
.tldr-card {
  margin-top: 24rpx;
  border: 2rpx solid var(--t-paper-dim);
  border-left: 6rpx solid var(--accent);
  border-radius: 10rpx;
  background: var(--t-paper-hi);
  padding: 22rpx 24rpx 12rpx;
}
.tldr-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.tldr-bar { width: 8rpx; height: 30rpx; background: var(--navy-1); border-radius: 2rpx; }
.tldr-title { font-size: 28rpx; font-weight: 700; color: var(--ink); letter-spacing: 2rpx; }
.tldr-cap { font-size: 19rpx; color: var(--muted); letter-spacing: 3rpx; margin-left: auto; }
.tldr-item { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 14rpx; }
.tldr-idx {
  flex-shrink: 0;
  width: 34rpx; height: 34rpx;
  border-radius: 8rpx;
  background: var(--navy-1);
  color: var(--white-ink);
  font-size: 21rpx;
  display: flex; align-items: center; justify-content: center;
}
.tldr-text { font-size: 27rpx; line-height: 1.6; color: var(--ink); font-weight: 600; }

/* ══ v0.6.0 追问对话流：基于本篇解答接地的免费追问（气泡式，蓝图色调）══ */
.fu-card { padding: 26rpx 28rpx 24rpx; }
.fu-head { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 20rpx; }
.fu-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: var(--navy-1);
  color: var(--white-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.fu-head-main { display: flex; flex-direction: column; gap: 4rpx; }
.fu-title { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.fu-sub { font-size: 21rpx; color: var(--muted); line-height: 1.5; }
.fu-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 20rpx; }
.fu-item { display: flex; flex-direction: column; gap: 12rpx; }
.fu-q { display: flex; align-items: flex-start; gap: 12rpx; justify-content: flex-end; }
.fu-q-tag {
  order: 2;
  flex-shrink: 0;
  width: 34rpx; height: 34rpx;
  border-radius: 8rpx;
  background: var(--accent);
  color: var(--navy-0);
  font-size: 21rpx;
  display: flex; align-items: center; justify-content: center;
}
.fu-q-text {
  order: 1;
  max-width: 80%;
  background: var(--t-amber-bg);
  border: 2rpx solid var(--t-amber-line);
  border-radius: 12rpx 2rpx 12rpx 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx; line-height: 1.55; color: var(--ink);
}
.fu-a { display: flex; align-items: flex-start; gap: 12rpx; }
.fu-a-tag {
  flex-shrink: 0;
  width: 56rpx; height: 34rpx;
  border-radius: 8rpx;
  background: var(--navy-1);
  color: var(--white-ink);
  font-size: 20rpx;
  display: flex; align-items: center; justify-content: center;
}
.fu-a-text {
  background: var(--t-paper-cool);
  border: 2rpx solid var(--t-blue-tint);
  border-radius: 2rpx 12rpx 12rpx 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx; line-height: 1.6; color: var(--ink-2);
}
.fu-a-pending .fu-a-text { color: var(--muted); }
.fu-waiting { letter-spacing: 2rpx; }
.fu-a-error .fu-a-text { border-color: var(--t-stamp-bg); background: var(--t-stamp-bg); color: var(--t-stamp-deep); }
.fu-dotpulse {
  flex-shrink: 0;
  margin-top: 10rpx;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--accent);
  animation: fupulse 1.2s ease-in-out infinite;
}
@keyframes fupulse { 0%, 100% { opacity: 0.25; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1.15); } }
.fu-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid var(--t-paper-dim);
  border-radius: 12rpx;
  background: var(--t-paper-hi);
  padding: 10rpx 10rpx 10rpx 22rpx;
}
.fu-input { flex: 1; font-size: 26rpx; color: var(--ink); height: 64rpx; }
.fu-send {
  flex-shrink: 0;
  padding: 0 30rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: var(--navy-1);
  color: var(--white-ink);
  font-size: 25rpx;
  display: flex; align-items: center; justify-content: center;
  letter-spacing: 2rpx;
}
.fu-send-hover { background: var(--navy-2); }
.fu-send-off { opacity: 0.4; }
