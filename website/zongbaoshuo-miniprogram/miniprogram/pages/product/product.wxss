/* 产品详情页 — 图纸卡 (sheet) 风 */

.page {
  padding: 32rpx 32rpx 48rpx;
}

.sheet {
  display: flex;
  background: var(--paper2);
  border: 3rpx solid var(--ink);
  border-radius: 10rpx;
  box-shadow: 10rpx 10rpx 0 rgba(24, 34, 54, 0.85);
  overflow: hidden;
}

/* 侧栏轨 */
.sheet-rail {
  flex-shrink: 0;
  width: 88rpx;
  background: var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  gap: 14rpx;
}

.sheet-rail .no {
  color: var(--acc-bright);
  font-size: 40rpx;
}

.sheet-rail .bar-v {
  width: 3rpx;
  flex: 1;
  background: rgba(244, 241, 232, 0.25);
}

.sheet-rail .rail-zh {
  writing-mode: vertical-rl;
  color: var(--paper);
  font-size: 28rpx;
  letter-spacing: 10rpx;
}

.sheet-body {
  flex: 1;
  padding: 30rpx 26rpx 34rpx;
  min-width: 0;
}

.prod-title {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.prod-title .t {
  font-size: 48rpx;
  color: var(--ink);
  line-height: 1.25;
}

.prod-title .en {
  font-size: 22rpx;
  color: var(--blue);
  font-weight: 600;
}

.pos {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--mut);
  line-height: 1.7;
}

.pos .b {
  font-weight: 800;
  color: var(--ink);
}

/* 图 */
.fig {
  margin-top: 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  overflow: hidden;
  background: #fff;
}

.fig-img {
  width: 100%;
  display: block;
}

.fig.narrow {
  max-width: 400rpx;
  margin-left: auto;
  margin-right: auto;
}

.fig-duo {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fig-cap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 18rpx;
  border-top: 2rpx solid var(--line);
  background: var(--paper);
}

.fig-cap .b {
  font-size: 21rpx;
  color: var(--ink);
  font-weight: 700;
}

.fig-cap .i {
  font-size: 18rpx;
  color: var(--faint);
  flex-shrink: 0;
}

/* 特性 */
.feat {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feat-item {
  padding-left: 20rpx;
  border-left: 5rpx solid var(--blue);
}

.feat-item .ft {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
}

.feat-item .fd {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--mut);
  line-height: 1.65;
}

/* 指标 */
.metrics {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.metric {
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  text-align: center;
}

.metric.wide {
  grid-column: 1 / -1;
  background: var(--ink);
  border-color: var(--ink);
}

.metric .v {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--blue-deep);
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.metric .k {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--faint);
}

.metric.wide .v {
  color: var(--acc-bright);
  font-size: 34rpx;
}

.metric.wide .k {
  color: #93a1c2;
}

/* 大数 */
.bignums {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.bignum {
  text-align: center;
  padding: 18rpx 8rpx;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
}

.bignum.flag {
  border-color: var(--acc);
  background: rgba(232, 89, 12, 0.05);
}

.bignum .v {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
}

.bignum .u {
  font-size: 17rpx;
  color: var(--faint);
  margin-left: 4rpx;
}

.bignum .k {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--faint);
}

/* 漏斗 */
.funnel {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.fstep {
  text-align: center;
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  background: var(--paper);
  padding: 14rpx 30rpx;
}

.fstep.top {
  width: 92%;
}

.funnel .fstep:nth-child(2) { width: 78%; }
.funnel .fstep:nth-child(3) { width: 64%; }
.funnel .fstep:nth-child(4) { width: 50%; }
.funnel .fstep:nth-child(5) { width: 36%; }

.fstep.dark {
  background: var(--ink);
  border-color: var(--ink);
}

.fstep .fm {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink);
}

.fstep .fs {
  display: block;
  font-size: 18rpx;
  color: var(--faint);
  margin-top: 2rpx;
}

.fstep.dark .fm {
  color: var(--paper);
}

.fstep.dark .fs {
  color: #93a1c2;
}

.ffoot {
  font-size: 19rpx;
  color: var(--faint);
  margin-top: 6rpx;
}

.subsec {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: var(--ink);
}

.subsec .b {
  font-weight: 800;
}

/* 六项机制 */
.mech {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.mech .step {
  text-align: center;
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  padding: 16rpx 8rpx;
  background: #fff;
  position: relative;
}

.mech .szh {
  display: block;
  font-size: 30rpx;
  color: var(--ink);
}

.mech .sen {
  display: block;
  font-size: 15rpx;
  color: var(--acc);
  letter-spacing: 3rpx;
  margin-top: 4rpx;
}

.mech .step:not(:last-child)::after {
  content: "→";
  position: absolute;
  right: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--acc);
  font-weight: 900;
  font-size: 22rpx;
  z-index: 2;
}

/* 场景 */
.industries {
  margin-top: 28rpx;
  border: 2rpx dashed var(--line);
  border-radius: 8rpx;
  padding: 22rpx;
}

.industries .cap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink);
}

.industries .badge {
  font-size: 15rpx;
  color: var(--acc);
  border: 2rpx solid var(--acc);
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
}

.ind-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ind-chips .ind {
  font-size: 21rpx;
  padding: 8rpx 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--mut);
}

.ind-chips .ind::before {
  content: "◆ ";
  color: var(--acc);
  font-size: 15rpx;
}

.industries .note {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--faint);
}

/* 五力汇流 */
.forces {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: stretch;
}

.frow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--ink);
  background: var(--paper);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}

.frow .fname {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink);
}

.frow .farr {
  color: var(--acc);
  font-weight: 900;
}

.fhub {
  margin-top: 8rpx;
  background: var(--ink);
  border-radius: 10rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.fhub .fh {
  color: var(--paper);
  font-size: 38rpx;
}

.fhub .fe {
  color: var(--acc-bright);
  font-size: 17rpx;
  letter-spacing: 4rpx;
}

.fnote {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--faint);
}

/* 底牌 */
.only-line {
  margin-top: 34rpx;
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 22rpx;
  background: #fff;
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
}

.only-line .stamp {
  flex-shrink: 0;
  border: 3rpx solid var(--acc);
  color: var(--acc);
  font-weight: 900;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  transform: rotate(-6deg);
}

.only-line .ol-text {
  font-size: 23rpx;
  color: var(--mut);
  line-height: 1.7;
}

/* 跳转 CTA (总包AI顾问) */
.jump-cta {
  margin-top: 30rpx;
  padding: 26rpx;
  border: 3rpx solid var(--ink);
  border-left: 10rpx solid var(--acc);
  border-radius: 10rpx;
  background: var(--paper2);
  box-shadow: 8rpx 8rpx 0 rgba(24, 34, 54, 0.18);
}

.jump-hover {
  background: #fff;
  box-shadow: 8rpx 8rpx 0 rgba(232, 89, 12, 0.35);
}

.jc-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.jc-head .b {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.jc-head .jc-live {
  flex-shrink: 0;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #fff;
  background: #0f7b4f;
  border-radius: 4rpx;
  padding: 4rpx 10rpx;
}

.jc-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--mut);
  line-height: 1.7;
}

.jc-btn {
  margin-top: 20rpx;
  text-align: center;
  background: var(--acc);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  padding: 20rpx 0;
  box-shadow: 5rpx 5rpx 0 rgba(24, 34, 54, 0.22);
}

.jump-cta:active .jc-btn {
  background: var(--acc-bright);
}

/* 获取指南 (顾问眼镜) */
.guide {
  margin-top: 30rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--blue);
  border-radius: 10rpx;
}

.guide-title .b {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--blue-deep);
}

.gstep {
  margin-top: 20rpx;
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.gstep .gno {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 2rpx solid var(--blue);
  color: var(--blue-deep);
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #fff;
}

.gstep .gbody {
  flex: 1;
  min-width: 0;
}

.gstep .gt {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--ink);
}

.gstep .gd {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--mut);
  line-height: 1.6;
}

.gnote {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: var(--faint);
  border-top: 2rpx dashed var(--line);
  padding-top: 16rpx;
}

/* 导航行 */
.nav-row {
  margin-top: 36rpx;
  display: flex;
  gap: 18rpx;
}

.nav-btn {
  flex: 1;
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  background: var(--paper2);
  padding: 18rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nav-btn.right {
  text-align: right;
  align-items: flex-end;
}

.nav-btn:active {
  background: #fff;
}

.nav-btn .dir {
  font-size: 18rpx;
  color: var(--acc);
  font-weight: 700;
}

.nav-btn .nm {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
}

.home-hint {
  margin-top: 26rpx;
  text-align: center;
  font-size: 18rpx;
  color: var(--faint);
}
