/* 首页 — 纸张蓝图风 */

.page {
  padding-bottom: 40rpx;
}

/* ---------- HERO ---------- */
.hero {
  padding: 40rpx 32rpx 48rpx;
  position: relative;
  overflow: hidden;
  border-bottom: 2rpx solid var(--line);
}

.live-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--blue-deep);
  border: 2rpx solid var(--blue);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  background: rgba(43, 86, 192, 0.06);
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--acc);
  animation: blink 1.6s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.hero-title {
  margin-top: 28rpx;
  font-size: 64rpx;
  line-height: 1.28;
  color: var(--ink);
  letter-spacing: 4rpx;
}

.hero-title .em {
  color: var(--acc);
  position: relative;
}

.hero-slogan {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--blue-deep);
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--mut);
}

.hero-desc .b {
  font-weight: 700;
  color: var(--ink);
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 30rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--paper2);
  color: var(--ink);
  font-weight: 600;
}

.chip .no {
  color: var(--blue);
  font-size: 19rpx;
  margin-right: 8rpx;
  font-weight: 700;
}

.chip .arr {
  margin-left: 8rpx;
  color: var(--acc);
  font-weight: 900;
}

.chip-hover {
  border-color: var(--acc);
  background: #fff;
}

.chip:active {
  border-color: var(--acc);
  color: var(--acc);
}

.chips-hint {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--mut);
  letter-spacing: 2rpx;
}

/* 图纸卡 */
.dwg-card {
  position: relative;
  margin-top: 40rpx;
  background: var(--paper2);
  border: 3rpx solid var(--ink);
  box-shadow: 10rpx 10rpx 0 rgba(24, 34, 54, 0.85);
  border-radius: 8rpx;
  padding: 28rpx;
}

.corner {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
}

.corner.c3 { left: -3rpx; top: -3rpx; border-left: 5rpx solid var(--acc); border-top: 5rpx solid var(--acc); }
.corner.c4 { right: -3rpx; bottom: -3rpx; border-right: 5rpx solid var(--acc); border-bottom: 5rpx solid var(--acc); }

.dwg-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 2rpx dashed var(--line);
  padding-bottom: 14rpx;
}

.dwg-head .b {
  font-size: 28rpx;
  font-weight: 800;
}

.dwg-no {
  font-size: 18rpx;
  color: var(--faint);
}

.dwg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(24, 34, 54, 0.08);
}

.dwg-row .k {
  font-size: 22rpx;
  color: var(--faint);
}

.dwg-row .v {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.dwg-row .num {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--blue-deep);
  font-family: "Songti SC", "STSong", "SimSun", serif;
}

.dwg-row .u {
  font-size: 20rpx;
  color: var(--mut);
}

.loop {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: var(--ink);
  border-radius: 6rpx;
}

.loop .b {
  color: var(--paper);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.dwg-stamp {
  position: absolute;
  right: 22rpx;
  top: 96rpx;
  border: 3rpx solid var(--acc);
  color: var(--acc);
  font-size: 22rpx;
  font-weight: 900;
  padding: 4rpx 10rpx;
  transform: rotate(8deg);
  opacity: 0.85;
  border-radius: 4rpx;
  letter-spacing: 4rpx;
}

/* ---------- 战绩带 (滚动) ---------- */
.marquee {
  overflow: hidden;
  background: var(--ink);
  padding: 16rpx 0;
}

.mq-track {
  display: inline-flex;
  white-space: nowrap;
  animation: mq 26s linear infinite;
}

.mq-item {
  color: #dbe2f2;
  font-size: 22rpx;
  padding: 0 26rpx;
  font-weight: 600;
}

@keyframes mq {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ---------- 数据带 ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  background: var(--line);
  border-bottom: 2rpx solid var(--line);
}

.stat {
  background: var(--paper);
  padding: 26rpx 10rpx;
  text-align: center;
}

.stat .v {
  font-size: 40rpx;
  color: var(--ink);
  line-height: 1.2;
}

.stat .k {
  font-size: 20rpx;
  color: var(--faint);
  margin-top: 6rpx;
}

/* ---------- 通用段落 ---------- */
.sec {
  padding: 56rpx 32rpx 20rpx;
}

.sec-title.light {
  color: #f4f1e8;
}

.lede {
  font-size: 25rpx;
  color: var(--mut);
  margin-bottom: 30rpx;
}

.lede .b {
  color: var(--ink);
  font-weight: 700;
}

.subsec {
  margin-top: 34rpx;
  font-size: 24rpx;
  color: var(--ink);
}

/* ---------- AI 原生宣言 (暗色) ---------- */
.native {
  background: linear-gradient(160deg, #18233f 0%, #0f182c 100%);
  padding: 56rpx 32rpx 44rpx;
}

.eyebrow-dark {
  color: var(--acc-bright);
}

.ncell {
  display: flex;
  gap: 22rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  background: rgba(244, 241, 232, 0.05);
  border: 2rpx solid rgba(244, 241, 232, 0.16);
  border-radius: 8rpx;
}

.ncell .ico {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid var(--acc-bright);
  color: var(--acc-bright);
  border-radius: 8rpx;
  font-size: 30rpx;
}

.ncell .nbody {
  flex: 1;
}

.ncell .nh {
  color: #f4f1e8;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ncell .nen {
  font-size: 17rpx;
  color: var(--acc-bright);
  letter-spacing: 3rpx;
}

.ncell .np {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #93a1c2;
  line-height: 1.7;
}

.fly-title {
  margin-top: 36rpx;
  color: #8fb0ff;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 700;
}

.flow-dark .fn {
  background: rgba(244, 241, 232, 0.08);
  border-color: rgba(244, 241, 232, 0.35);
  color: #dbe2f2;
}

.flow-dark .fn.hot {
  background: var(--acc);
  color: #fff;
}

.fly-note {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #93a1c2;
}

.pin-dark {
  background: rgba(232, 89, 12, 0.14);
  border-left-color: var(--acc-bright);
  color: #f4f1e8;
}

.pin-dark .em {
  color: var(--acc-bright);
}

/* ---------- 四重价值 / 八位一体 卡 ---------- */
.ucell {
  position: relative;
  margin-top: 26rpx;
  padding: 26rpx 26rpx 22rpx;
  background: var(--paper2);
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  box-shadow: 6rpx 6rpx 0 rgba(24, 34, 54, 0.12);
}

.ucell-tap:active,
.ucell-hover {
  background: #fff;
  box-shadow: 6rpx 6rpx 0 rgba(232, 89, 12, 0.35);
}

.ucell .role {
  font-size: 19rpx;
  color: var(--acc);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.ucell .uh {
  margin-top: 10rpx;
  font-size: 34rpx;
  color: var(--ink);
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ucell .uen,
.ucell .ui {
  font-size: 18rpx;
  color: var(--blue);
  letter-spacing: 2rpx;
}

.ucell .up {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--mut);
  line-height: 1.7;
}

.ucell .ud {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--acc);
  font-weight: 700;
}

/* 产品卡 CTA 行: 左注脚 + 右「查看详情」胶囊 */
.ucta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.ucta .uct {
  font-size: 21rpx;
  color: var(--acc);
  font-weight: 700;
}

.ucta .ucgo {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--acc);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  letter-spacing: 2rpx;
  box-shadow: 4rpx 4rpx 0 rgba(24, 34, 54, 0.18);
}

.ecard-hover {
  background: #fff;
  box-shadow: 6rpx 6rpx 0 rgba(232, 89, 12, 0.35);
}

.ecard .ego {
  margin-top: 12rpx;
  text-align: right;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--acc);
  letter-spacing: 2rpx;
}

/* ---------- 资产盘点表 ---------- */
.ledger {
  border: 3rpx solid var(--ink);
  border-radius: 8rpx;
  background: var(--paper2);
  overflow: hidden;
  box-shadow: 8rpx 8rpx 0 rgba(24, 34, 54, 0.12);
}

.ledger-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--ink);
  padding: 16rpx 22rpx;
}

.ledger-head .b {
  color: var(--paper);
  font-size: 26rpx;
}

.ledger-head .sub {
  color: #93a1c2;
  font-size: 18rpx;
}

.ledger-row {
  padding: 22rpx;
  border-bottom: 1rpx solid rgba(24, 34, 54, 0.1);
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-row .cat {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ledger-row .cn {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--blue-deep);
}

.ledger-row .en {
  font-size: 17rpx;
  color: var(--faint);
  letter-spacing: 2rpx;
}

.ledger-row .desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--mut);
  line-height: 1.65;
}

.ledger-row .val {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.ledger-row .num {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--acc);
}

.ledger-row .unit {
  font-size: 20rpx;
  color: var(--mut);
}

.ledger-row .small {
  margin-left: auto;
  font-size: 19rpx;
  color: var(--faint);
}

/* ---------- 收入引擎 ---------- */
.ecard {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 2rpx solid var(--ink);
  border-radius: 8rpx;
  background: var(--paper2);
  position: relative;
}

.ecard.on {
  border-left: 8rpx solid var(--acc);
}

.ecard.soon {
  border-left: 8rpx dashed var(--acc);
  background: rgba(232, 89, 12, 0.04);
}

.etags {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.etags .live {
  font-size: 18rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.ecard.on .live {
  background: #0f7b4f;
  color: #fff;
}

.ecard.soon .live {
  border: 2rpx solid var(--acc);
  color: var(--acc);
}

.etags .etag {
  font-size: 18rpx;
  color: var(--faint);
}

.ehead {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 12rpx;
}

.ehead .eh {
  font-size: 32rpx;
  color: var(--ink);
}

.price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.price .pv {
  font-size: 38rpx;
  color: var(--acc);
  font-weight: 900;
}

.price .pu {
  font-size: 19rpx;
  color: var(--mut);
}

.ecard .ep {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--mut);
}

/* ---------- 联系 ---------- */
.contact-card {
  border: 3rpx solid var(--ink);
  border-radius: 10rpx;
  background: var(--paper2);
  padding: 36rpx 28rpx;
  box-shadow: 10rpx 10rpx 0 rgba(24, 34, 54, 0.85);
}

.en-line {
  font-size: 18rpx;
  color: var(--faint);
  letter-spacing: 4rpx;
  margin-top: 2rpx;
}

.act {
  margin-top: 26rpx;
  padding: 20rpx;
  border: 2rpx dashed var(--line);
  border-radius: 8rpx;
}

.act .ano {
  font-size: 19rpx;
  color: var(--acc);
  font-weight: 700;
}

.act .ah {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.act .ap {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--mut);
}

.cta-block {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.cta-desc {
  font-size: 24rpx;
  color: var(--mut);
}

.mega-cta {
  margin-top: 24rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 8rpx;
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mega-cta text {
  font-size: 30rpx;
  font-weight: 800;
}

.mega-cta .cta-sub {
  font-size: 17rpx;
  color: var(--acc-bright);
  letter-spacing: 3rpx;
  font-weight: 400;
}

.qr-card {
  position: relative;
  align-self: center;
  width: 420rpx;
  padding: 30rpx 30rpx 24rpx;
  background: #fff;
  border: 3rpx solid var(--ink);
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.corner.qc3 { left: -3rpx; top: -3rpx; border-left: 5rpx solid var(--acc); border-top: 5rpx solid var(--acc); }
.corner.qc4 { right: -3rpx; bottom: -3rpx; border-right: 5rpx solid var(--acc); border-bottom: 5rpx solid var(--acc); }

.qr-img {
  width: 330rpx;
  height: 330rpx;
}

.qr-b {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--ink);
}

.qr-sub {
  font-size: 18rpx;
  color: var(--faint);
}

.qr-save {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--blue-deep);
  border: 2rpx solid var(--blue);
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
}

.qr-save:active {
  background: var(--blue);
  color: #fff;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: 40rpx;
  background: var(--ink);
  padding: 48rpx 32rpx 30rpx;
}

.foot-zh {
  color: var(--paper);
  font-size: 44rpx;
}

.foot-zh .em {
  color: var(--acc-bright);
}

.foot-slogan {
  margin-top: 10rpx;
  color: #dbe2f2;
  font-size: 26rpx;
  font-weight: 700;
}

.foot-slogan .em {
  color: var(--acc-bright);
}

.foot-desc {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #93a1c2;
  line-height: 1.9;
}

.foot-base {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(244, 241, 232, 0.14);
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
}

.foot-base text {
  font-size: 16rpx;
  color: #707b93;
  letter-spacing: 2rpx;
}
