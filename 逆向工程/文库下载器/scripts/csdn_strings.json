  "s": "\n      (function() {\n        // 检查收费标识\n        const priceEl = document.querySelector('.dl-price, .resource-price, [class*=\"price\"]')\n        const priceText = priceEl ? priceEl.textContent.trim() : ''\n        // 检查是否有积分/C币价格\n        const hasPaid = /[1-9]d*s*(积分|C币|元)/.test(priceText) ||\n          document.querySelector('.paid-resource, [class*=\"paid\"]') !== null\n        // 检查 VIP 免费标识\n        const isVipFree = document.querySelector('.vip-free, [class*=\"vip-free\"], .free-resource') !== null ||\n          /vips*免费|VIPs*免费/i.test(document.body.textContent)\n        // 获取资源标题\n        const title = document.querySelector('h1, .resource-title, .dl-title')?.textContent?.trim() || ''\n        return { hasPaid, isVipFree, priceText, title }\n      })()\n    "
 },
