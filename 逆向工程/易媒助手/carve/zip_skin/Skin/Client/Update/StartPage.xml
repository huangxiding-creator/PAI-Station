<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window>
<UpStartPageLayout bkcolor="#FFFFFFFF">
	<HorizontalLayout name="hor_bk"  height="286" bkimage="Update\bk.png">
		<Control />
		<Button name="btn_close" padding="0,5,0,0" width="20" height="20" bkimage="public\close_white.png" />
		<Control width="5" />
	</HorizontalLayout>
	<Control height="20" />
	<TabLayout name="tab_check" selectedid="0" padding="20,0,20,0">
		<VerticalLayout>
			<Label text="恭喜您，助手已是最新版本" height="16" font="3" textcolor="#FF2C2C2C" align="left" valign="align"/>	
			<Control height="5" />
			<Label height="22" font="0" text="您目前的助手已是最新版本，无需升级。" textcolor="#FF5E5E5E" align="left" valign="align"/>				
			<Control height="20" />
			<HorizontalLayout height="72" bordersize="0,1,0,0" bordercolor="0xfff4f4f4">
				<Control />
				<Button name="btn_ok" text="我知道了" padding="0,20,0,0" width="78" height="32" textcolor="0xffffffff" normalimage="file='public/B02.png' source='0,0,30,32' corner='10,10,10,10'" hotimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" pushedimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" font="0" />
			</HorizontalLayout>
		</VerticalLayout>
		<VerticalLayout>
			<Label text="抱歉，助手更新失败了" height="16" font="3" textcolor="#FFFA1942" align="left" valign="align"/>	
			<Control height="5" />
			<Text name="text_fail_tip" showhtml="true" width="540" height="22" font="0" text="{f 0}{c #5e5e5e}请点击重新更新或到{/c}{/f}{a}{f 1}{c #6358ed}官网{/c}{/f}{/a}{f 0}{c #5e5e5e}下载重新安装即可{/c}{/f}" align="left" valign="align"/>				
			<Control height="20" />
			<HorizontalLayout height="72" bordersize="0,1,0,0" bordercolor="0xfff4f4f4">
				<Control />
				<Button name="btn_startclient" xmltext="Update/12" padding="0,20,0,0" width="78" height="32" textcolor="0xff5e5e5e" normalimage="file='public/B01.png' source='0,0,30,32' corner='10,10,10,10'" hotimage="file='public/B01.png' source='0,32,30,64' corner='10,10,10,10'" pushedimage="file='public/B01.png' source='0,32,30,64' corner='10,10,10,10'" font="0" />
				<Control width="20"/>
				<Button name="btn_retry" text="重新更新" padding="0,20,0,0" width="78" height="32" textcolor="0xffffffff" normalimage="file='public/B02.png' source='0,0,30,32' corner='10,10,10,10'" hotimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" pushedimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" font="0" />
			</HorizontalLayout>
		</VerticalLayout>
		<VerticalLayout>
			<Label text="正在检测更新，请稍后..." height="16" font="3" textcolor="#FF2C2C2C" align="left" valign="align"/>	
			<Control height="5" />
			<Label height="22" font="0" text="目前正在为您检测助手的最新版本，请不要关闭检测窗口" textcolor="#FF5E5E5E" align="left" valign="align"/>				
			<Control height="20" />
			<HorizontalLayout height="72" bordersize="0,1,0,0" bordercolor="0xfff4f4f4">
				<Control />
				<Button enabled="false" text="请稍后…" padding="0,20,0,0" width="78" height="32" textcolor="0xffffffff" xmldisabletextcolor="TXTCOLOR_7_9f" xmlnormalimage="IMG_BTN_BK_1" xmlhotimage="IMG_BTN_BK_2" xmlpushedimage="IMG_BTN_BK_2" xmldisabledimage="IMG_BTN_BK_1" font="0" />
			</HorizontalLayout>
		</VerticalLayout>
		<VerticalLayout >
			<Text name="txt_update_detail" showhtml="true"  width="540" height="20" textcolor="#FF666666"  vscrollbar="true" multiline="true" />
			<Control height="20" />
			<HorizontalLayout height="72" bordersize="0,1,0,0" bordercolor="0xfff4f4f4">
				<Text name="text_tip" padding="0,28,0,0" height="16" showhtml="true" text="{f 0}{c #5e5e5e}若升级失败，请到{/c}{/f}{a}{f 0}{c #6358ed}官网{/c}{/f}{/a}{f 0}{c #5e5e5e}下载重新安装即可{/c}{/f}" align="left"  valign="center"/>
				<Control width="10"/>
				<Button name="btn_startupdate" text="立即更新" padding="0,20,0,0" width="78" height="32" textcolor="0xffffffff" normalimage="file='public/B02.png' source='0,0,30,32' corner='10,10,10,10'" hotimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" pushedimage="file='public/B02.png' source='0,32,30,64' corner='10,10,10,10'" font="0" />
			</HorizontalLayout>
		</VerticalLayout>
	</TabLayout>
</UpStartPageLayout>
</Window>
