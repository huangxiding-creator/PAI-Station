              },
              "pPr": {
                "jc": "both",
                "spacing": {
                  "line": "1.5x"
                },
                "ind": {
                  "firstLine": "2ch"
                }
              },
              "rPr": {
                "rFonts": {
                  "eastAsia": "宋体"
                },
                "sz": 22
              }
            }
          ]
        }
      },
      "reason": "selftest strict-props"
