/* 兼容入口页 — v0.5.1：落地即跳咨询首页，本页只做一瞬蓝图闪屏 */
.home-splash {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  color: var(--white-ink);
  overflow: hidden;
}
.home-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  animation: rise 0.4s cubic-bezier(0.22, 0.9, 0.3, 1) both;
}
.home-glyph {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  border: 5rpx double rgba(var(--t-glow-rgb), 0.5);
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; font-weight: 800;
  color: var(--accent);
  text-shadow: 0 0 24rpx rgba(var(--t-accent-rgb), 0.4);
}
.home-title {
  font-size: 44rpx; font-weight: 800; letter-spacing: 6rpx;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.25);
}
.home-sub {
  font-size: 24rpx; color: var(--ink-dim); letter-spacing: 2rpx;
}
.home-loading {
  margin-top: 26rpx;
  font-size: 19rpx; letter-spacing: 5rpx;
  color: rgba(var(--t-inkdim-rgb), 0.6);
  animation: pulse 1.1s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
