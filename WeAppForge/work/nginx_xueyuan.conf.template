# 总包学园·研报商城 nginx 反代模板（域名与备案 TBD 用户定——ARCHITECTURE §七）
# 惯例对齐 ECS 既有 conf.d 四站（weaipo-8881/paistation-8882/wechatbrief-8883/
# zongbaoshuo-8884）：独立 conf 文件、server 块、gzip、X-Content-Type-Options。
# 落位用法（部署日，T-P0-24 之后）：替换 __XUEYUAN_DOMAIN__ 两处 →
#   云助手: printf %s '<本文件 b64>' | base64 -d > /etc/nginx/conf.d/xueyuan-api.conf
#   && nginx -t && systemctl reload nginx
# 注意: 本模板不 listen 专用端口（四站惯例），走 80/443 域名虚拟主机——
#   与既有站零冲突（它们 server_name _ + 专用端口，本站绑域名）。

server {
    listen 80;
    listen [::]:80;
    server_name __XUEYUAN_DOMAIN__;      # TODO 用户定域名+备案后替换

    # 小程序正式环境 request 合法域名强制 https —— 域名备案后补 443 (certbot)；
    # 开发/体验版可直连 http://47.120.43.20:8871 + 工具端「不校验合法域名」。

    # 业务 API：引擎自带 /api/v1 前缀（API_DESIGN §二），原样透传不改写路径
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8871;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;           # 双 PDF 流式下发（NFR-03 TTFB<2s 留裕量）
        proxy_buffering off;              # 流式下载不缓冲
    }

    # 公网健康探针（与引擎 /health 同判据 200 {ok:true}）
    location = /health {
        proxy_pass http://127.0.0.1:8871/health;
        access_log off;
    }

    # 根路径无静态站（商城全部动态走引擎+小程序），裸访问不泄内部态
    location = / { return 404; }

    gzip on;
    gzip_types application/json;
    add_header X-Content-Type-Options nosniff;
}
