/* detail.wxss — 研报详情页 */
@import "../../styles/pay-sheet.wxss"; /* 支付前披露弹层（templates/pay-sheet.wxml 配套） */
@import "../../styles/p1-sheet.wxss"; /* P1 三弹层（templates/p1-sheet.wxml 配套：点赞/组队/批评） */
.detail {
  padding-bottom: 160rpx;
}
.head-top {
  display: flex;
  gap: 24rpx;
}
.cover-block {
  flex-shrink: 0;
  width: 150rpx;
  height: 200rpx;
  border-radius: 14rpx;
  background: linear-gradient(150deg, #2a6bff, #173d99);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 6rpx;
}
.head-main {
  flex: 1;
  min-width: 0;
}
.d-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}
.d-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.rank-badge {
  font-size: 20rpx;
  color: #b25e00;
  background: #fdf3e7;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}
.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f2f5;
  color: #4e5561;
}
.tag.kw {
  background: #e8efff;
  color: #1e5eff;
}
.tagrow {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.d-summary {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6b7178;
  line-height: 1.8;
}
.sec-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

/* 决策卡 */
.dcd-row {
  display: flex;
  gap: 16rpx;
}
.dcd-item {
  flex: 1;
  background: #f6f8fd;
  border-radius: 14rpx;
  padding: 20rpx;
}
.dcd-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e5eff;
}
.dcd-label {
  font-size: 22rpx;
  color: #6b7178;
  margin-top: 6rpx;
}
/* 高试读比报告付费范围明示（决策②）：暖底提示条 */
.paywall-note {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a6d1a;
  background: #fff8e1;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  line-height: 1.6;
}
.locked-title {
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.locked-list {
  margin-top: 12rpx;
}
.locked-item {
  font-size: 26rpx;
  color: #9aa1ab;
  padding: 10rpx 0;
  filter: blur(4rpx);
  user-select: none;
}

/* 目录树 */
.toc-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.toc-item.trial .toc-name {
  color: #1e5eff;
}
.toc-name {
  flex: 1;
  font-size: 28rpx;
}
.toc-flag {
  font-size: 20rpx;
  color: #07c160;
  background: #e8f7ef;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.toc-lock {
  font-size: 24rpx;
}

/* 预览三件套 */
.rel-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rel-title {
  font-size: 28rpx;
  font-weight: 600;
}
.rel-why {
  font-size: 22rpx;
  color: #6b7178;
  margin-top: 4rpx;
}
.also {
  margin-top: 20rpx;
}
.also-title {
  font-size: 24rpx;
  color: #6b7178;
  margin-bottom: 8rpx;
}
.also-item {
  font-size: 26rpx;
  padding: 10rpx 0;
  color: #2a2f38;
}

/* 价格锚 */
.price-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.price-main {
  font-size: 52rpx;
  font-weight: 800;
  color: #ff6010;
}
.price-main .rmb {
  font-size: 30rpx;
  margin-right: 4rpx;
}
.anchor-right {
  flex: 1;
}
.anchor-copy {
  font-size: 26rpx;
  font-weight: 600;
  color: #2a2f38;
}
.anchor-ref {
  font-size: 22rpx;
  color: #9aa1ab;
  margin-top: 6rpx;
}
.anchor-strike {
  text-decoration: line-through;
  margin-left: 6rpx;
}

/* 入口区 */
.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 26rpx;
}
.entry:last-child {
  border-bottom: none;
}
.entry-arrow {
  color: #b6bcc4;
  font-size: 30rpx;
}
.foot-disclosure {
  text-align: center;
  color: #b6bcc4;
  font-size: 22rpx;
  padding: 32rpx 0 8rpx;
}

/* 底部操作栏 */
.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.fav {
  width: 96rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4e5561;
}
.fav.on {
  color: #ff6010;
}
.fav.like {
  width: 108rpx;
  color: #07c160;
}
.fav.like.busy {
  color: #9aa1ab;
}
.read-btn {
  width: 200rpx;
  font-size: 26rpx;
  color: #1e5eff;
  border-color: #1e5eff;
  border-radius: 999rpx;
}
.buy-btn {
  flex: 1;
  background: #1e5eff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}
.buy-btn.gray {
  background: #c3c9d2;
}
.buy-btn.owned {
  background: #07c160;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 20, 30, 0.5);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
}
.sheet-body {
  max-height: 560rpx;
}
.form-row {
  font-size: 24rpx;
  color: #6b7178;
  margin: 20rpx 0 8rpx;
}
.form-input {
  background: #f6f7f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.form-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9aa1ab;
  line-height: 1.7;
}
.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}
.sheet-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 999rpx;
}
.sheet-btn.primary {
  background: #1e5eff;
  color: #fff;
}
.rules-text {
  font-size: 26rpx;
  line-height: 1.9;
  color: #2a2f38;
}
.empty {
  text-align: center;
  color: #9aa1ab;
  padding: 120rpx 40rpx;
}
.retry-btn {
  margin-top: 24rpx;
  color: #1e5eff;
  border-color: #1e5eff;
  font-size: 26rpx;
}
