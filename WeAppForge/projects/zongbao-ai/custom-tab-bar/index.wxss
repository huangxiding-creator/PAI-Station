/* 自绘 tabBar — 蓝图底 + 图框字标（v0.7.3 周换装：全变量化，随主题注入） */
.bar {
  display: flex;
  background: var(--navy-0);
  background-image:
    linear-gradient(rgba(var(--t-glow-rgb), 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--t-glow-rgb), 0.055) 1px, transparent 1px);
  background-size: 32rpx 32rpx;
  border-top: 2rpx solid rgba(var(--t-glow-rgb), 0.28);
  padding: 14rpx 0 calc(env(safe-area-inset-bottom) + 10rpx);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

/* 图框字标：方框+单字（工程图纸索引符号的语言） */
.tab-sq {
  width: 58rpx;
  height: 58rpx;
  border-radius: 8rpx;
  border: 3rpx solid rgba(var(--t-inkdim-rgb), 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}
.tab-glyph {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-dim);
  transition: color 0.18s ease;
}
.tab-t {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--ink-dim);
}

/* 激活：安全橙填充 + 上浮微光 */
.tab-on .tab-sq {
  background: linear-gradient(180deg, var(--t-accent-soft), var(--accent-deep));
  border-color: var(--accent);
  box-shadow: 0 8rpx 20rpx rgba(var(--t-accent-rgb), 0.4);
  transform: translateY(-4rpx);
}
.tab-on .tab-glyph { color: var(--navy-0); }
.tab-on .tab-t { color: var(--accent); font-weight: 700; }
