/* 自绘 tabBar — 蓝图底 + 图框字标 */
.bar {
  display: flex;
  background: #081a36;
  background-image:
    linear-gradient(rgba(101, 160, 255, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(101, 160, 255, 0.055) 1px, transparent 1px);
  background-size: 32rpx 32rpx;
  border-top: 2rpx solid rgba(101, 160, 255, 0.28);
  padding: 14rpx 0 calc(env(safe-area-inset-bottom) + 10rpx);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

/* 图框字标：方框+单字（工程图纸索引符号的语言） */
.tab-sq {
  width: 58rpx;
  height: 58rpx;
  border-radius: 8rpx;
  border: 3rpx solid rgba(147, 172, 209, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}
.tab-glyph {
  font-size: 28rpx;
  font-weight: 700;
  color: #93acd1;
  transition: color 0.18s ease;
}
.tab-t {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #93acd1;
}

/* 激活：安全橙填充 + 上浮微光 */
.tab-on .tab-sq {
  background: linear-gradient(180deg, #ffa53f, #f0821a);
  border-color: #ff9432;
  box-shadow: 0 8rpx 20rpx rgba(255, 148, 50, 0.4);
  transform: translateY(-4rpx);
}
.tab-on .tab-glyph { color: #0a1e3c; }
.tab-on .tab-t { color: #ff9432; font-weight: 700; }
