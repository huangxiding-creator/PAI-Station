/* 我的页 — v0.3.0 蓝图设计：工程档案 */
.page { padding-bottom: 260rpx; }

/* ══ 档案头（蓝图底） ══ */
.head {
  color: var(--white-ink);
  padding: 0 32rpx 40rpx;
}
.head-nav {
  display: flex; align-items: center;
  padding: 0 4rpx;
}
.head-title {
  font-size: 22rpx; letter-spacing: 6rpx;
  color: var(--ink-dim); font-weight: 600;
}
.head-inner {
  display: flex; align-items: center; gap: 24rpx;
  margin-top: 10rpx;
  animation: rise 0.5s cubic-bezier(0.22, 0.9, 0.3, 1) both;
}
/* 图框头像：方形索引符号 */
.avatar-frame {
  width: 100rpx; height: 100rpx;
  border-radius: 10rpx;
  border: 3rpx solid rgba(101, 160, 255, 0.55);
  background: rgba(8, 26, 54, 0.6);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 0 0 6rpx rgba(8, 26, 54, 0.8), 0 0 24rpx rgba(101, 160, 255, 0.18);
}
.avatar-glyph { font-size: 46rpx; font-weight: 800; color: var(--white-ink); }
.head-info { flex: 1; }
.nick { font-size: 32rpx; font-weight: 800; letter-spacing: 2rpx; }
.head-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-dim); letter-spacing: 2rpx; }
.head-no { font-size: 20rpx; color: rgba(147, 172, 209, 0.6); letter-spacing: 3rpx; align-self: flex-start; margin-top: 6rpx; }

/* ══ 额度票据组 ══ */
.sheet-head {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 22rpx;
}
.quota-grid { display: flex; align-items: stretch; }
.q-item { flex: 1; text-align: center; }
.q-num { font-size: 52rpx; font-weight: 800; color: var(--navy-1); line-height: 1.2; }
.q-num-main { color: var(--accent-deep); text-shadow: 0 0 20rpx rgba(255, 148, 50, 0.25); }
.q-label { font-size: 20rpx; letter-spacing: 3rpx; color: var(--muted); margin-top: 6rpx; }
.q-perf { border-left: 3rpx dashed var(--line); margin: 8rpx 0; }
.quota-rule { margin-top: 22rpx; border-top: 2rpx dashed var(--line); padding-top: 18rpx; letter-spacing: 0.5rpx; }

.center-pad { text-align: center; padding: 40rpx 0; }
.mini-retry { width: 40%; margin-top: 16rpx; }

/* ══ 空态：空白图纸 ══ */
.blank-sheet { text-align: center; padding: 44rpx 0 24rpx; }
.blank-frame {
  position: relative;
  width: 220rpx; height: 150rpx;
  margin: 0 auto;
  border: 3rpx dashed rgba(13, 37, 71, 0.3);
  border-radius: 8rpx;
  background:
    linear-gradient(rgba(29, 111, 208, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(29, 111, 208, 0.05) 1px, transparent 1px);
  background-size: 30rpx 30rpx;
}
.blank-cross {
  position: absolute; left: 50%; top: 42%;
  width: 36rpx; height: 36rpx; transform: translate(-50%, -50%);
  background:
    linear-gradient(rgba(13, 37, 71, 0.25), rgba(13, 37, 71, 0.25)) center/100% 2rpx no-repeat,
    linear-gradient(rgba(13, 37, 71, 0.25), rgba(13, 37, 71, 0.25)) center/2rpx 100% no-repeat;
}
.blank-mark {
  position: absolute; left: 50%; bottom: 10rpx; transform: translateX(-50%);
  font-size: 17rpx; letter-spacing: 4rpx; color: rgba(13, 37, 71, 0.35);
}
.empty-text { font-size: 30rpx; font-weight: 700; margin: 24rpx 0 6rpx; letter-spacing: 1rpx; }
.empty-btn { width: 45%; margin-top: 28rpx; }

/* ══ 图纸列表 ══ */
.hist-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 4rpx;
  border-bottom: 2rpx dashed var(--line);
}
.hist-item:last-child { border-bottom: none; }
.hist-hover { opacity: 0.7; }
.hist-no {
  flex-shrink: 0;
  font-size: 21rpx; color: rgba(13, 37, 71, 0.4);
  letter-spacing: 1rpx;
  writing-mode: horizontal-tb;
  border: 2rpx solid rgba(13, 37, 71, 0.18);
  border-radius: 4rpx;
  padding: 4rpx 8rpx;
}
.hist-main { flex: 1; min-width: 0; }
.hist-q {
  font-size: 29rpx; font-weight: 600; line-height: 1.5; color: var(--ink);
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.hist-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; flex-wrap: wrap; }
.hist-time { font-size: 22rpx; }
.hist-arrow { color: rgba(13, 37, 71, 0.3); font-size: 34rpx; }
.hist-badge {
  font-size: 20rpx; color: #8a5a10; background: #f8efdc;
  border: 2rpx solid #ecd9b4;
  border-radius: 4rpx; padding: 2rpx 12rpx;
}
.hist-liked { color: var(--accent-deep); background: #fdf3e4; border-color: #f3d5ab; }
.hist-pending { color: var(--draft); background: #e9f1fb; border-color: #d3e2f4; }
.hist-err { color: #b3352a; background: #fbeae6; border-color: #f0cfc7; }

/* ══ 批量导出按钮（用户令 v0.5.0）══ */
.export-all-btn {
  margin: 26rpx 0 4rpx;
  line-height: 2.3;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  border-radius: 8rpx;
}
