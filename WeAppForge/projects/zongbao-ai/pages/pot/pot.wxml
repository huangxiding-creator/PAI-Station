<view class="page">

  <!-- ══ 蓝图头部：锅圈 · 打破砂锅问到底 ══ -->
  <view class="hero bp-grid ticks">
    <view style="height: {{nav.statusBarHeight}}px;"></view>
    <view class="hero-nav" style="height: {{nav.navHeight}}px"></view>

    <view class="hero-inner">
      <view class="hero-kicker">POT CIRCLE · BREAK THE POT</view>
      <view class="hero-title">锅圈</view>
      <view class="hero-sub">打破砂锅问到底 · EPC 总承包热点难点问题，由背后的顶级总包智库逐一拆解答疑</view>

      <view class="hero-dwg mono">DWG NO. {{sheetNo}} · SCALE 1:1<view class="dim-rule"></view><text class="dim-cap">HOT</text></view>
    </view>
  </view>

  <!-- 列表 -->
  <block wx:if="{{loading}}">
    <view class="card">
      <view class="sk sk-title"></view>
    </view>
    <view class="card">
      <view class="sk sk-line"></view>
      <view class="sk sk-line"></view>
      <view class="sk sk-line short"></view>
    </view>
  </block>

  <view class="card ticks err-card" wx:elif="{{loadError}}">
    <view class="err-kicker kicker kicker-on-paper">ERROR · 加载遇到问题</view>
    <view class="muted">{{loadError}}</view>
    <button class="btn-primary retry-btn" hover-class="btn-hover" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 空态：锅还没热 -->
  <view class="card ticks" wx:elif="{{items.length === 0}}">
    <view class="pot-empty">
      <view class="pot-empty-glyph">锅</view>
      <view class="pot-empty-title">锅正在升温</view>
      <view class="muted">智库正在准备 EPC 热点问题解答，稍后再来看看</view>
    </view>
  </view>

  <!-- 热点问题列表：问题 + 答案前 100 字预览，点开看全文 -->
  <block wx:else>
    <view
      class="card ticks pot-item rise"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItem"
      hover-class="pot-hover"
      style="animation-delay: {{index * 40}}ms"
    >
      <view class="pot-head">
        <view class="pot-no mono">H-{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</view>
        <view class="pot-q">{{item.question}}</view>
      </view>
      <view class="pot-preview">{{item.preview}}…</view>
      <view class="pot-foot">
        <text class="pot-meta mono">{{item.full_chars}} 字全文</text>
        <view class="pot-like {{item.liked ? 'pot-like-on' : ''}}">
          <text class="pot-like-glyph">{{item.liked ? '❤' : '♡'}}</text>
          <text class="mono">{{item.likes}}</text>
        </view>
        <text class="pot-more">看全文 ›</text>
      </view>
    </view>

    <view class="muted tip-line">点开任意热点 · 「有用/导出/纠错/分享」同样各 +1 次咨询机会</view>
  </block>

  <view class="safe-bottom"></view>
</view>
