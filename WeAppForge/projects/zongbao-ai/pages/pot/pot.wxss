/* 锅圈页 — v0.5.0 蓝图设计：蓝图头 + 热点问题卡片列表 */
.page { padding-bottom: 40rpx; }

/* ══ 蓝图头部（同 ask 页语言）══ */
.hero {
  position: relative;
  color: var(--white-ink);
  padding: 0 36rpx 44rpx;
  overflow: hidden;
}
.hero-nav { position: relative; }
.hero-inner { position: relative; animation: rise 0.5s cubic-bezier(0.22, 0.9, 0.3, 1) both; }

.hero-kicker {
  font-size: 19rpx;
  letter-spacing: 7rpx;
  color: var(--ink-dim);
  font-weight: 600;
}
.hero-title {
  margin-top: 14rpx;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.25);
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--ink-dim);
  letter-spacing: 1rpx;
  line-height: 1.7;
}
.hero-inner::after {
  content: '';
  position: absolute; right: 0; top: 8rpx;
  width: 34rpx; height: 34rpx;
  background:
    linear-gradient(var(--ink-dim), var(--ink-dim)) center/100% 2rpx no-repeat,
    linear-gradient(var(--ink-dim), var(--ink-dim)) center/2rpx 100% no-repeat;
  opacity: 0.65;
}
.hero-dwg {
  margin-top: 26rpx;
  font-size: 19rpx;
  letter-spacing: 4rpx;
  color: rgba(147, 172, 209, 0.5);
  display: flex;
  align-items: center;
}
.dim-rule {
  flex: 1;
  height: 18rpx;
  margin: 0 20rpx;
  border-left: 2rpx solid rgba(147, 172, 209, 0.4);
  border-right: 2rpx solid rgba(147, 172, 209, 0.4);
  position: relative;
}
.dim-rule::before {
  content: '';
  position: absolute; left: 0; right: 0; top: 8rpx;
  border-top: 2rpx solid rgba(147, 172, 209, 0.4);
}
.dim-cap {
  font-size: 16rpx;
  color: rgba(147, 172, 209, 0.45);
  letter-spacing: 2rpx;
  border: 2rpx solid rgba(147, 172, 209, 0.35);
  border-radius: 4rpx;
  padding: 0 6rpx;
  line-height: 1.5;
}

/* ══ 热点问题卡片 ══ */
.pot-item { padding: 28rpx 28rpx 22rpx; }
.pot-hover { transform: scale(0.985); }
.pot-head { display: flex; gap: 18rpx; align-items: flex-start; }
.pot-no {
  flex-shrink: 0;
  font-size: 21rpx;
  color: rgba(13, 37, 71, 0.4);
  letter-spacing: 1rpx;
  border: 2rpx solid rgba(13, 37, 71, 0.18);
  border-radius: 4rpx;
  padding: 4rpx 8rpx;
  margin-top: 4rpx;
}
.pot-q {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.55;
  color: var(--ink);
}
.pot-preview {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  border-left: 6rpx solid rgba(29, 111, 208, 0.35);
  padding-left: 18rpx;
}
.pot-foot {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}
.pot-meta { font-size: 21rpx; color: var(--muted); letter-spacing: 1rpx; }
.pot-like {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 22rpx; color: var(--muted);
}
.pot-like-glyph { font-size: 26rpx; line-height: 1; }
.pot-like-on { color: #d9534f; }
.pot-more {
  margin-left: auto;
  font-size: 23rpx;
  color: var(--draft);
  letter-spacing: 1rpx;
}

/* ══ 空态：锅正在升温 ══ */
.pot-empty { text-align: center; padding: 60rpx 30rpx; }
.pot-empty-glyph {
  width: 120rpx; height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  border: 4rpx double rgba(13, 37, 71, 0.3);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; font-weight: 800; color: var(--navy-1);
}
.pot-empty-title { font-size: 30rpx; font-weight: 700; margin: 26rpx 0 8rpx; letter-spacing: 1rpx; }

/* 骨架屏 */
.sk { background: linear-gradient(90deg, #ece8db 25%, #f5f2e8 45%, #ece8db 65%); background-size: 400% 100%; animation: shimmer 1.4s ease infinite; border-radius: 6rpx; }
@keyframes shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
.sk-title { height: 40rpx; width: 60%; }
.sk-line { height: 30rpx; margin-top: 24rpx; }
.sk-line.short { width: 55%; }

/* 失败卡 */
.err-card { text-align: center; padding: 60rpx 32rpx; }
.err-kicker { display: block; margin-bottom: 14rpx; }
.retry-btn { margin-top: 30rpx; width: 60%; }

.tip-line { text-align: center; padding: 10rpx 24rpx 0; letter-spacing: 1rpx; font-size: 21rpx; }
