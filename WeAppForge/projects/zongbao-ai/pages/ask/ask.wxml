<page-meta page-style="{{themeStyle}}" />
<view class="page">

  <!-- ══ 蓝图头部：问题写在蓝图上 ══ -->
  <view class="hero bp-grid ticks">
    <view style="height: {{nav.statusBarHeight}}px;"></view>
    <view class="hero-nav" style="height: {{nav.navHeight}}px;"></view>

    <view class="hero-inner">
      <view class="hero-kicker">GENERAL CONTRACTOR · AI ADVISOR</view>
      <view class="hero-title">总包AI顾问</view>
      <!-- v0.7.7 深度合成合规：AI 生成显著标识（hero 内嵌高对比，拒审 599847679 整改） -->
      <view class="hero-ai">
        <text class="hero-ai-badge">AI生成</text>
        <text class="hero-ai-text">本服务内容由人工智能（AI）生成 · 仅供参考</text>
      </view>
      <view class="hero-sub">专业参考源自「总包智库」· 总包人的随身工程顾问 / 招投标 / 签约 / 风险 / 造价争议 / 审计 / 合同实务</view>

      <!-- 额度票根 -->
      <view class="quota-ticket" wx:if="{{quota}}">
        <view class="qt-left">
          <view class="qt-label">今日咨询额度</view>
          <view class="qt-num mono">{{quota.total_left}}</view>
        </view>
        <view class="qt-perf"></view>
        <view class="qt-right">
          <view class="qt-kv">剩余 {{quota.free_left}} 次</view>
          <view class="qt-kv" wx:if="{{quota.bonus_left > 0}}">互动加赠 {{quota.bonus_left}} 次</view>
          <view class="qt-kv qt-dim" wx:else>有用/纠错 各+1次</view>
        </view>
      </view>
      <view class="quota-ticket quota-empty" wx:else>
        <view class="qt-left">
          <view class="qt-label">今日咨询额度</view>
          <view class="qt-num mono">–</view>
        </view>
        <view class="qt-perf"></view>
        <view class="qt-right">
          <view class="qt-kv qt-dim">发起首次咨询后显示</view>
        </view>
      </view>

      <view class="hero-dwg mono">DWG NO. {{sheetNo}} · SCALE 1:1<view class="dim-rule"></view><text class="dim-cap">SHT 1/1</text></view>
    </view>
  </view>

  <!-- 连接状态自检：失败时常驻警示卡 -->
  <view class="net-down ticks" wx:if="{{netStatus === 'down'}}" bindtap="recheck">
    <text>⚠ 无法连接服务 · 点击重试，请检查手机网络是否可用</text>
  </view>

  <!-- v0.7.5 深度合成合规：AI 标识已并入上方 hero 徽章（一页一处显眼提示，1008 用户令） -->

  <!-- ══ 咨询问题单：白图纸面（先写问题） ══ -->
  <view class="card ticks ask-card rise" style="animation-delay: 60ms">
    <view class="sheet-head">
      <text class="kicker kicker-on-paper">咨询问题 · CONSULTATION</text>
      <text class="sheet-no mono">NO. {{sheetNo}}</text>
    </view>
    <textarea
      class="ask-input"
      value="{{question}}"
      placeholder="例如：EPC 固定总价合同下材料暴涨，能申请调价吗？依据和操作步骤是什么？"
      placeholder-class="ask-ph"
      maxlength="500"
      bindinput="onInput"
      focus="{{qFocus}}"
      auto-height
      show-confirm-bar="{{false}}"
    ></textarea>
    <view class="ask-foot">
      <text class="char-count mono">{{charCount}}/500</text>
      <text class="clear-btn" wx:if="{{charCount > 0}}" bindtap="onClear" hover-class="clear-hover">清空</text>
    </view>
  </view>

  <!-- ══ 智库底座信任带（可证成口径：与智库页库存盘点同数；1008 用户令：突出总包智库+强信任）══ -->
  <!-- v0.9.5 审计修（L18）：四数改 {{kbStats}} 同源渲染（utils/kbstats.js），不再与智库页各自硬编码 -->
  <view class="kb-strip rise" style="animation-delay: 75ms">
    <block wx:for="{{kbStats}}" wx:key="l">
      <view wx:if="{{index > 0}}" class="kb-div"></view>
      <view class="kb-cell"><text class="kb-n mono">{{item.n}}</text><text class="kb-l">{{item.l}}</text></view>
    </block>
  </view>
  <view class="kb-cred muted">智库沉淀自总包之声（2013 年至今公益运行）与总包学园 · 每条回答附依据来源，点开可查证</view>

  <!-- ══ 双按钮排：AI优化提问（左）+ 立即咨询（右，1009 免费字样下线令）══ -->
  <!-- v0.9.4（1009 真机实测修复）：撤 disabled——自定义样式盖掉置灰态，"看着能点点了没反应"；
       改为恒可点+必反馈（空问 toast+聚焦输入框），弱化态只做视觉（btn-dim）不打断点击 -->
  <view class="btn-row rise" style="animation-delay: 90ms">
    <button
      class="btn-ghost opt-btn {{canAsk ? '' : 'btn-dim'}}"
      disabled="{{optimizing}}"
      hover-class="btn-hover"
      bindtap="onOptimize"
    >{{optimizing ? 'AI 优化中…' : 'AI优化提问'}}</button>
    <button
      class="btn-primary ask-btn {{canAsk ? '' : 'btn-dim'}}"
      disabled="{{asking}}"
      hover-class="btn-hover"
      bindtap="onSubmit"
    >{{asking ? '智库检索中…' : '立即咨询'}}</button>
  </view>
  <view class="opt-hint muted" wx:if="{{!optimizing}}">AI优化提问：把您的问题改写成更深入、更究竟的递进式三小问</view>

  <!-- ══ 示范性问题：EPC 热点题库 ══ -->
  <view class="card ticks rise" style="animation-delay: 140ms">
    <view class="sheet-head">
      <text class="kicker kicker-on-paper">示范性问题 · SAMPLE QUESTIONS</text>
      <text class="sheet-no">每条都是递进三问</text>
    </view>
    <view class="chips">
      <view
        class="chip"
        wx:for="{{samples}}"
        wx:key="tag"
        data-i="{{index}}"
        bindtap="onSample"
        hover-class="chip-hover"
      ><text class="chip-tag">{{item.tag}}</text><text class="chip-3q mono">三问</text></view>
    </view>
  </view>

  <view class="bottom-bar safe-bottom rise" style="animation-delay: 220ms">
    <view class="muted tip-line">有用/纠错各 +1 次（上不封顶）· 北京时间 0 点清零</view>
  </view>
</view>

<!-- v0.9.7 自绘弹窗系统：modal/loading 模式（onPopState 镜像开合+tabBar 压暗让路） -->
<qw-pop id="qwpop" bind:popstate="onPopState" />

<!-- bottom-bar 不用 fixed：本页是 tabBar 页，fixed bottom:0 会被 tabBar 盖住吃掉点击 -->
