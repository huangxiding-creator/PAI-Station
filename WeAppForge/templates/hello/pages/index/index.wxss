.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 16rpx;
}
.motto {
  font-size: 26rpx;
  color: #6b7178;
  margin-bottom: 48rpx;
}
.card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.count {
  font-size: 72rpx;
  font-weight: 700;
}
