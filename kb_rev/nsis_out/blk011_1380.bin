<?xml version="1.0" encoding="utf-8"?>
<Windows>
	<!--卸载启动页-->
	<VerticalLayout bkcolor="#FFFFFF">
		<!-- 顶部标题区域 -->
		<VerticalLayout height="30" bkcolor="#F5F5F5">
			<Label text="卸载百度文库" height="20" padding="0,10,0,0" align="center" textcolor="#333333" font="2"/>
		</VerticalLayout>
		
		<!-- 主要内容区域 -->
		<VerticalLayout padding="40,20,40,0" childpadding="0" childvalign="center">
			<!-- 提示文本 -->
			<Label text="确定要卸载百度文库吗？卸载后将无法使用相关功能。" height="24" align="center" textcolor="#666666" font="1"/>
			
			<!-- 卸载图标区域 -->
			<VerticalLayout height="200" padding="0,10,0,0" bkimage="file='res\img_bg_uninstall.png'" align="center"/>
			
			<!-- 按钮区域 -->
			<HorizontalLayout height="48" padding="0,20,0,0">
				<Control />
				<Button name="okUninstallBtn" text="确认卸载" width="180" textcolor="#23AD82" font="1" normalimage="res\button\btn_dialog_black.png" hotimage="res\button\btn_dialog_black_hover.png"/>
				<Control width="20" />
				<Button name="cancelUninstallBtn" text="暂不卸载" width="180" textcolor="#FFFFFF" font="1" normalimage="res\button\btn_dialog_green.png" hotimage="res\button\btn_dialog_green_hover.png"/>
				<Control />
			</HorizontalLayout>
		</VerticalLayout>
	</VerticalLayout>
</Windows>
