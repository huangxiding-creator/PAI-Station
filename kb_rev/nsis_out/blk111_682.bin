!macro customUnInstall
  ; 在卸载前运行清理脚本
  ExecWait '"$INSTDIR\resources\app\scripts\cleanup.js"'
  
  ; 使用 taskkill 强制结束所有相关进程
  nsExec::Exec 'taskkill /F /IM "${APP_EXECUTABLE_FILENAME}"'
  nsExec::Exec 'taskkill /F /IM gpuprocess.exe'
  nsExec::Exec 'taskkill /F /IM renderer.exe'
  nsExec::Exec 'taskkill /F /IM electron.exe'
  nsExec::Exec 'taskkill /F /IM crashpad_handler.exe'
  nsExec::Exec 'taskkill /F /IM chrome_crashpad_handler.exe'
  
  ; 等待一会儿确保进程都被清理
  Sleep 2000
  
  ; 删除应用数据
  RMDir /r "$LOCALAPPDATA\${APP_FILENAME}"
  RMDir /r "$APPDATA\${APP_FILENAME}"
!macroend
