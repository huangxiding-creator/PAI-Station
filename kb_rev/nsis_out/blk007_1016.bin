<?xml version="1.0" encoding="utf-8"?>
<Windows>
	<!-- 安装完成页 -->
	<VerticalLayout padding="0,-5,0,0">
		<VerticalLayout padding="98,0,0,0" width="404" height="310" bkimage="file='res\img_bg_install.png'"/>

		<VerticalLayout>
			<Button name="CompleteTab_CompleteBtn" text="立即启动" width="208" height="78" padding="196,0,0,0" align="center" textpadding="0,0,4,14" normalimage="res\button\btn_install_enable.png" hotimage="res\button\btn_install_hover.png" pushedimage="res\button\btn_install_enable.png" textcolor="#FFFFFFFF" font="0"/>
			<CheckBox name="CompleteTab_AutoLaunchCheckBox" width="88" height="13" padding="256,0,0,0" heigh="12" text="开机自动启动" textcolor="#FF666666" selected="true" textpadding="16,0,0,0" normalimage="file='res\checkbox\check_no.png' dest='0,0,12,12'" hotimage="file='res\checkbox\check_hover.png' dest='0,0,12,12'" selectedimage="file='res\checkbox\check_yes.png' dest='0,0,12,12'" font="2"/>
		</VerticalLayout>
	</VerticalLayout>
</Windows>
