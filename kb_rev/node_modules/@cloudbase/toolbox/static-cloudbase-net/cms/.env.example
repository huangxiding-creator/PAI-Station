# 复制为 .env 后填写，.env 不入仓库

# CDN 域名（构建时资源 URL 前缀，末尾是否带斜杠均可）
CDN_BASE=https://tcbjssdk-cdn-5g9n6m9scceec659-1258016615.tcloudbaseapp.com

# CloudBase 环境 ID（默认 tcbjssdk-cdn-5g9n6m9scceec659）
TCB_ENV_ID=tcbjssdk-cdn-5g9n6m9scceec659

# 发布鉴权（通过环境变量注入，不要填真实值）
API_KEYID=
API_KEY=

# 发布环境：pre | prod（默认 pre）
CMS_ENV=pre
