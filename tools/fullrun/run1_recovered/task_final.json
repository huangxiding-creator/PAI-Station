85\u5bb9\n\uff08\u5206\u7ef4\u5ea6\u68b3\u7406\uff0c\u6bcf\u9879\u5e26\u6761\u6b3e\u6eaf\u6e90\uff09\n1.1 \u9879\u76ee\u540d\u79f0\uff1a\u5e73\u9876\u5c71\u5e02\u767d\u9f9f\u6e56\u751f\u6001\u73af\u5883\u4fdd\u62a42015\u5e74\u5ea6\u30012016\u5e74\u5ea6\u5de5\u7a0b\u7c7b\u9879\u76ee\u65bd\u5de5\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.1\u6761\uff09\u3002\n1.2 \u62db\u6807\u8303\u56f4\uff1a\u65c5\u6e38\u533a\u519c\u5bb6\u4e50\u96c6\u805a\u5730\u5783\u573e\u4e0e\u6c61\u6c34\u5904\u7406\u3001\u6cbf\u5cb8\u6751\u843d\u6c61\u6c34\u5904\u7406\u3001\u5927\u6d6a\u6cb3\u5165\u6c99\u6cb3\u53e3\u6e7f\u5730\u53ca\u6cb3\u9053\u7f13\u51b2\u5e26\u751f\u6001\u4fee\u590d\u5de5\u7a0b\u3001\u8ba9\u6cb3\u5165\u6c99\u6cb3\u53e3\u533a\u53ca\u6ee8\u5cb8\u7f13\u51b2\u5e26\u6e7f\u5730\u6062\u590d\u793a\u8303\u5de5\u7a0b\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.2\u6761\uff09\u3002\n1.3 \u8d28\u91cf\u8981\u6c42\uff1a\u7b26\u5408\u56fd\u5bb6\u53ca\u884c\u4e1a\u65bd\u5de5\u9a8c\u6536\u89c4\u8303\uff0c\u8fbe\u5230\u5408\u683c\u6807\u51c6\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.3\u6761\uff09\u3002\n1.4 \u5de5\u671f\uff1a240\u65e5\u5386\u5929\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.4\u6761\uff09\u3002\n\n## \u4e8c\u3001\u6280\u672f\u4e0e\u6807\u51c6\u8981\u6c42\n\uff08\u89c4\u8303\u6e05\u5355\u6309\u7c7b\u522b\u5206\u7ec4\u8ba1\u6570\u5217\u51fa\uff0c\u5982\"\u7ed3\u6784\u7c7b\u89c4\u8303(\u5171N\u9879)\"\uff0c\u9010\u6761\u7f16\u53f7\uff09\nNULL\uff08\u539f\u6587\u4e2d\u65e0\u4efb\u4f55\u5173\u4e8e\u6280\u672f\u89c4\u8303\u548c\u6807\u51c6\u7684\u8868\u8ff0\uff09\n\n## \u4e09\u3001\u5b9e\u65bd\u4e0e\u7ba1\u7406\u8981\u6c42\n\uff08\u8fdb\u5ea6/\u8d28\u91cf/\u5b89\u5168/\u4eba\u5458/\u8bbe\u5907\u7b49\uff0c\u9010\u9879\uff09\n3.1 \u8fdb\u5ea6\uff1a240\u65e5\u5386\u5929\u5b8c\u6210\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.4\u6761\uff09\u3002\n3.2 \u8d28\u91cf\uff1a\u7b26\u5408\u56fd\u5bb6\u53ca\u884c\u4e1a\u65bd\u5de5\u9a8c\u6536\u89c4\u8303\uff0c\u8fbe\u5230\u5408\u683c\u6807\u51c6\uff08\u89c1\u62db\u6807\u516c\u544a\u7b2c1.3\u6761\uff09\u3002\n3.3 \u5b89\u5168\uff1a\u5177\u5907\u6709\u6548\u7684\u5b89\u5168\u751f\u4ea7\u8bb8\u53ef\u8bc1\uff0c\u9879\u76ee\u7ecf\u7406\u987b\u5177\u6709\u6709\u6548\u7684\u5b89\u5168\u751f\u4ea7\u8003\u6838\u5408\u683c\u8bc1\uff0c\u4e14\u63d0\u4f9b\u65e0\u5728\u5efa\u58f0\u660e\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.2\u6761\uff09\u3002\n3.4 \u4eba\u5458\uff1a\u9879\u76ee\u7ecf\u7406\u987b\u5177\u6709\u5e02\u653f\u516c\u7528\u5de5\u7a0b\u4e13\u4e1a\u8d30\u7ea7\u53ca\u4ee5\u4e0a\u5efa\u9020\u5e08\u6ce8\u518c\u8d44\u683c\u548c\u6709\u6548\u7684\u5b89\u5168\u751f\u4ea7\u8003\u6838\u5408\u683c\u8bc1\uff0c\u4e14\u63d0\u4f9b\u65e0\u5728\u5efa\u58f0\u660e\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.2\u6761\uff09\u3002\n3.5 \u8bbe\u5907\uff1a\u65bd\u5de5\u7ec4\u7ec7\u8bbe\u8ba1\u53ca\u4e3b\u8981\u65bd\u5de5\u8bbe\u5907\uff08\u89c1\u6295\u6807\u6587\u4ef6\u8981\u6c42\u7b2c3.1\u6761\uff09\u3002\n\n## \u56db\u3001\u8d44\u683c\u4e0e\u5408\u89c4\u8981\u6c42\n\uff08\u8d44\u8d28/\u4e1a\u7ee9/\u8d22\u52a1/\u4fe1\u7528\uff0c\u9010\u9879\uff09\n4.1 \u8d44\u8d28\uff1a\u5177\u5907\u5e02\u653f\u516c\u7528\u5de5\u7a0b\u65bd\u5de5\u603b\u627f\u5305\u4e09\u7ea7\u53ca\u4ee5\u4e0a\u8d44\u8d28\u548c\u73af\u4fdd\u5de5\u7a0b\u4e13\u4e1a\u627f\u5305\u4e09\u7ea7\u53ca\u4ee5\u4e0a\u8d44\u8d28\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.1\u6761\uff09\u3002\n4.2 \u4e1a\u7ee9\uff1a2014\u5e741\u6708\u4ee5\u6765\uff08\u4ee5\u5408\u540c\u7b7e\u8ba2\u65f6\u95f4\u4e3a\u51c6\uff09\u7c7b\u4f3c\u7684\u6c61\u6c34\u5904\u7406\u6216\u751f\u6001\u6062\u590d\u5efa\u8bbe\u9879\u76ee\u4e1a\u7ee9\uff0c\u4e14\u9879\u76ee\u89c4\u6a21\u4e0e\u672c\u62db\u6807\u9879\u76ee\u76f8\u5f53\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.4\u6761\uff09\u3002\n4.3 \u8d22\u52a1\uff1a\u8fd1\u4e09\u5e74\uff082014\u5e74\u30012015\u5e74\u30012016\u5e74\uff0c\u65b0\u6210\u7acb\u4f01\u4e1a\u4ece\u6210\u7acb\u4e4b\u65e5\u8d77\u8ba1\u7b97\uff09\u5e94\u5177\u6709\u826f\u597d\u7684\u8d22\u52a1\u72b6\u51b5\u3001\u8db3\u591f\u7684\u6d41\u52a8\u8d44\u91d1\u6765\u627f\u62c5\u672c\u9879\u76ee\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.5\u6761\uff09\u3002\n4.4 \u4fe1\u7528\uff1a\u8fd1\u4e09\u5e74\u5185\u5728\u7ecf\u8425\u6d3b\u52a8\u4e2d\u6ca1\u6709\u91cd\u5927\u8fdd\u6cd5\u3001\u8fdd\u7eaa\u884c\u4e3a\uff0c\u987b\u63d0\u4f9b\u68c0\u5bdf\u673a\u5173\u51fa\u5177\u7684\u5728\u6709\u6548\u671f\u5185\u7684\u65e0\u884c\u8d3f\u72af\u7f6a\u6863\u6848\u67e5\u8be2\u7ed3\u679c\u544a\u77e5\u51fd\uff08\u89c1\u6295\u6807\u4eba\u8d44\u683c\u8981\u6c42\u7b2c2.6\u6761\uff09\u3002\n\n## \u4e94\u3001\u5e9f\u6807\u98ce\u9669\u9879\n\uff08\u9010\u6761\u5217\uff1a\u26a0\ufe0f **\u2605\u5e9f\u6807\u9879**\uff1a<\u89e6\u53d1\u6761\u4ef6>\uff0c<\u540e\u679c>\uff08\u89c1\u7b2cX\u6761\uff09\uff09\n\u26a0\ufe0f **\u2605\u5e9f\u6807\u9879**\uff1a\u6295\u6807\u4eba\u672a\u6309\u62db\u6807\u6587\u4ef6\u8981\u6c42\u63d0\u4f9b\u6295\u6807\u4fdd\u8bc1\u91d1\uff0c\u5176\u6295\u6807\u6587\u4ef6\u4f5c\u5e9f\u6807\u5904\u7406\uff08\u89c1\u6295\u6807\u6587\u4ef6\u8981\u6c42\u7b2c3.4.1\u9879\uff09\u3002\n\u26a0\ufe0f **\u2605\u5e9f\u6807\u9879**\uff1a\u6295\u6807\u4eba\u672a\u6309\u62db\u6807\u6587\u4ef6\u8981\u6c42\u76d6\u7ae0\uff0c\u5176\u6295\u6807\u6587\u4ef6\u4f5c\u5e9f\u6807\u5904\u7406\uff08\u89c1\u6295\u6807\u6587\u4ef6\u8981\u6c42\u7b2c3.1.2\u6761\uff09\u3002\n\u26a0\ufe0f **\u2605\u5e9f\u6807\u9879**\uff1a\u6295\u6807\u6587\u4ef6\u65e0\u65bd\u5de5\u7ec4\u7ec7\u8bbe\u8ba1\u65b9\u6848\uff0c\u5176\u6295\u6807\u4f5c\u65e0\u6548\u6295\u6807\u5904\u7406\uff08\u89c1\u6295\u6807\u6587\u4ef6\u8981\u6c42\u7b2c3.1.2\u6761\uff09\u3002\n\u26a0\ufe0f **\u2605\u5e9f\u6807\u9879**\uff1a\u6295\u6807\u4eba\u9012\u4ea4\u4e24\u4efd\u6216\u591a\u4efd\u5185\u5bb9\u4e0d\u540c\u7684\u6295\u6807\u6587\u4ef6\uff0c\u6216\u8005\u4e00\u4efd\u6295\u6807\u6587\u4ef6\u4e2d\u5bf9\u7edf\u4e00\u62db\u6807\u9879\u76ee\u62a5\u6709\u4e24\u4