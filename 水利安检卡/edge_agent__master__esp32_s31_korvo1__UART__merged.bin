local lvgl = require("lvgl")

lvgl.init({
    buffer_lines = 10,
    tick_ms = 5,
    task_period_ms = 10,
})

local ok, err = pcall(function()
    local scr = lvgl.create_screen()
    local width = scr:get_size()
    scr:set_style({
        bg_color = "#101820",
    })

    lvgl.label(scr, {
        text = "LVGL Lua",
        align = "top_mid",
        x = 0,
        y = 20,
        text_color = "#f5f7fa",
    })

    local panel = lvgl.container(scr, {
        align = "center",
        w = width - 40,
        h = 150,
        bg_color = "#ffffff",
        bg_opa = 32,
        border_color = "#4f8cff",
        border_width = 1,
        radius = 8,
        pad = 10,
        pad_row = 8,
    })
    panel:set_flex({
        flow = "column",
        main = "center",
        cross = "center",
        track = "center",
    })

    local button = lvgl.button(panel, {
        text = "OK",
        w = 120,
        h = 44,
        radius = 6,
        bg_color = "#2f80ed",
        text_color = "#ffffff",
    })
    button:set_text("Updated")

    local checkbox = lvgl.checkbox(panel, {
        text = "checked",
        checked = true,
        text_color = "#f5f7fa",
    })

    local bar = lvgl.bar(scr, {
        align = "bottom_mid",
        x = 0,
        y = -54,
        w = width - 40,
        h = 18,
        min = 0,
        max = 100,
        value = 65,
        bg_color = "#263241",
    })
    bar:set_value(72)

    local slider = lvgl.slider(scr, {
        align = "bottom_mid",
        x = 0,
        y = -24,
        w = width - 40,
        h = 18,
        min = 0,
        max = 100,
        value = 35,
    })
    slider:set_range(0, 120)
    slider:set_value(48)

    local value = slider:get_value()
    checkbox:set_text("slider " .. value)

    scr:load()
    delay.delay_ms(5000)
end)

lvgl.deinit()

if not ok then
    error(err)
end
